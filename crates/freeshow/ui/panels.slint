    labels-disabled: bool,
    group-numbers: bool,
    split-lines: int,
    remote-port: int,
    remote-password: string,
    stage-port: int,
    max-connections: int,
    has-library: bool,
    icecast-host: string,
    icecast-port: string,
    icecast-mount: string,
    icecast-transport: string,
    icecast-main-mix: bool,
    icecast-routed: bool,
    theme: string,
    profiles: string,
    output-name: string,
    output-always-on-top: bool,
    output-kiosk: bool,
    output-resolution: string,
    text-transition: string,
    text-duration: int,
    text-direction: string,
    media-transition: string,
    media-duration: int,
    media-direction: string,
    style-names: [string],
    style-name: string,
    style-is-default: bool,
    style-background: string,
    style-swatch: color,
    style-fit: string,
    style-blur-amount: int,
    style-blur-opacity: int,
    style-lines: int,
    style-template: string,
    template-choices: [string],
    output-names: [string],
    theme-colors: [ThemeColorRow],
    theme-font: string,
    theme-font-size: int,
    theme-radius: int,
    theme-edited: bool,
}

