// SPDX-License-Identifier: GPL-3.0-only
// Settings, Inspector and Stage editor panels. Every edit calls back with one
// key/value pair; Rust validates it, writes the library file, and refreshes `data`.

import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox, Switch, TabWidget } from "std-widgets.slint";
import { OperatorStyle, BoxButton, HeaderButton, ListRow } from "widgets.slint";

export struct SettingsData {
    language: string,
    time-format: string,
    autosave: string,
    alert-updates: bool,
    auto-output: bool,
    out-locked: bool,
    full-colors: bool,
    labels-disabled: bool,
    group-numbers: bool,
    split-lines: int,
    remote-port: int,
    stage-port: int,
    max-connections: int,
    theme: string,
    profiles: string,
    output-name: string,
    output-always-on-top: bool,
    output-kiosk: bool,
    text-transition: string,
    text-duration: int,
    media-transition: string,
    media-duration: int,
    addresses: string,
    style-names: [string],
    style-name: string,
    style-is-default: bool,
    style-background: string,
    style-swatch: color,
    style-fit: string,
    style-blur-amount: int,
    style-blur-opacity: int,
    style-lines: int,
}

export struct InspectorData {
    has-item: bool,
    family: string,
    font-px: int,
    bold: bool,
    italic: bool,
    color: string,
    align: string,
    x: int,
    y: int,
    w: int,
    h: int,
    background: string,
    radius: int,
}

export struct StageRowData {
    id: string,
    kind: string,
    x: int,
    y: int,
    w: int,
    h: int,
    font-px: int,
    color: string,
}

component FieldLabel inherits Text {
    in property <color> text-color;
    color: root.text-color;
    font-size: 12px * OperatorStyle.font-scale;
    vertical-alignment: center;
    min-width: 96px;
}

component SettingLabel inherits FieldLabel {
    width: 160px;
    horizontal-stretch: 0;
}

component PanelHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> status;
    in property <color> text-color;
    in property <color> close-fill;
    callback close();
    spacing: 8px;
    height: 32px;
    Text {
        text: root.title;
        color: root.text-color;
        font-size: 15px * OperatorStyle.font-scale;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        text: root.status;
        color: root.text-color;
        font-size: 12px * OperatorStyle.font-scale;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
    HeaderButton {
        label: "Close";
        accent: root.close-fill;
        text-color: root.text-color;
        accent-text: root.text-color;
        clicked => { root.close(); }
    }
}

/// Finds a value's row in a combo box model; Rust answers so Slint needs no loop.
export global ComboIndex {
    pure callback find([string], string) -> int;
}

/// A combo box that shows `value` and follows it when the data changes, even after the
/// operator picked a row or the model was replaced (which resets std ComboBox to row 0).
component ValueCombo inherits ComboBox {
    in property <string> value;
    current-index: ComboIndex.find(self.model, self.value);
    changed value => { self.current-index = ComboIndex.find(self.model, self.value); }
    changed model => { self.current-index = ComboIndex.find(self.model, self.value); }
}

global Fmt {
    public pure function flag(on: bool) -> string {
        return on ? "true" : "false";
    }
}

export component SettingsPanel inherits Rectangle {
    in property <SettingsData> data;
    in property <[string]> themes;
    in property <[string]> autosave-choices;
    in property <[string]> transition-kinds;
    in property <string> status;
    in property <color> text-color;
    in property <color> close-fill;
    callback apply(string, string);
    callback close();
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        PanelHeader {
            title: "Settings";
            status: root.status;
            text-color: root.text-color;
            close-fill: root.close-fill;
            close => { root.close(); }
        }
        TabWidget {
            Tab {
                title: "General";
                VerticalLayout {
                alignment: start;
                GridLayout {
                    padding: 10px;
                    spacing: 8px;
                    Row {
                        SettingLabel { text: "Language"; text-color: root.text-color; }
                        LineEdit {
                            text: root.data.language;
                            placeholder-text: "en";
                            accepted(value) => { root.apply("language", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Time format"; text-color: root.text-color; }
                        ValueCombo {
                            model: ["24", "12"];
                            value: root.data.time-format;
                            selected(value) => { root.apply("timeFormat", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Autosave"; text-color: root.text-color; }
                        ValueCombo {
                            model: root.autosave-choices;
                            value: root.data.autosave;
                            selected(value) => { root.apply("autosave", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Updates"; text-color: root.text-color; }
                        Switch {
                            text: "Alert when a new version is released";
                            checked: root.data.alert-updates;
                            toggled => { root.apply("alertUpdates", Fmt.flag(self.checked)); }
                        }
                    }
                }
                }
            }
            Tab {
                title: "Display";
                VerticalLayout {
                alignment: start;
                GridLayout {
                    padding: 10px;
                    spacing: 8px;
                    Row {
                        SettingLabel { text: "Theme"; text-color: root.text-color; }
                        ValueCombo {
                            colspan: 2;
                            model: root.themes;
                            value: root.data.theme;
                            selected(value) => { root.apply("theme", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Outputs"; text-color: root.text-color; }
                        Switch {
                            text: "Open output on startup";
                            checked: root.data.auto-output;
                            toggled => { root.apply("autoOutput", Fmt.flag(self.checked)); }
                        }
                        Switch {
                            text: "Lock output";
                            checked: root.data.out-locked;
                            toggled => { root.apply("outLocked", Fmt.flag(self.checked)); }
                        }
                    }
                    Row {
                        SettingLabel {
                            text: root.data.output-name == "" ? "Output window" : "Output · " + root.data.output-name;
                            text-color: root.text-color;
                        }
                        Switch {
                            text: "Always on top";
                            checked: root.data.output-always-on-top;
                            toggled => { root.apply("outputAlwaysOnTop", Fmt.flag(self.checked)); }
                        }
                        Switch {
                            text: "Kiosk (fullscreen)";
                            checked: root.data.output-kiosk;
                            toggled => { root.apply("outputKiosk", Fmt.flag(self.checked)); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Slides"; text-color: root.text-color; }
                        Switch {
                            text: "Full group colors";
                            checked: root.data.full-colors;
                            toggled => { root.apply("fullColors", Fmt.flag(self.checked)); }
                        }
                        Switch {
                            text: "Group numbers";
                            checked: root.data.group-numbers;
                            toggled => { root.apply("groupNumbers", Fmt.flag(self.checked)); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Labels"; text-color: root.text-color; }
                        Switch {
                            text: "Hide button labels";
                            checked: root.data.labels-disabled;
                            toggled => { root.apply("labelsDisabled", Fmt.flag(self.checked)); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Split lines"; text-color: root.text-color; }
                        SpinBox {
                            colspan: 2;
                            minimum: 0;
                            maximum: 20;
                            value: root.data.split-lines;
                            edited(value) => { root.apply("splitLines", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Slide transition"; text-color: root.text-color; }
                        ValueCombo {
                            model: root.transition-kinds;
                            value: root.data.text-transition;
                            selected(value) => { root.apply("textTransition", value); }
                        }
                        SpinBox {
                            minimum: 0;
                            maximum: 10000;
                            step-size: 100;
                            value: root.data.text-duration;
                            edited(value) => { root.apply("textDuration", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Media transition"; text-color: root.text-color; }
                        ValueCombo {
                            model: root.transition-kinds;
                            value: root.data.media-transition;
                            selected(value) => { root.apply("mediaTransition", value); }
                        }
                        SpinBox {
                            minimum: 0;
                            maximum: 10000;
                            step-size: 100;
                            value: root.data.media-duration;
                            edited(value) => { root.apply("mediaDuration", value); }
                        }
                    }
                    Row {
                        Rectangle {}
                        Text {
                            colspan: 2;
                            text: "Durations are in milliseconds. A show or slide with its own transition keeps it.";
                            color: root.text-color;
                            opacity: 0.6;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
                }
            }
            Tab {
                title: "Styles";
                VerticalLayout {
                alignment: start;
                GridLayout {
                    padding: 10px;
                    spacing: 8px;
                    Row {
                        SettingLabel { text: "Output style"; text-color: root.text-color; }
                        ValueCombo {
                            model: root.data.style-names;
                            value: root.data.style-name;
                            selected(value) => { root.apply("outputStyle", value); }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                text: "New style";
                                clicked => { root.apply("styleNew", ""); }
                            }
                            Button {
                                text: "Delete style";
                                enabled: !root.data.style-is-default;
                                clicked => { root.apply("styleDelete", ""); }
                            }
                        }
                    }
                    Row {
                        SettingLabel { text: "Name"; text-color: root.text-color; }
                        LineEdit {
                            colspan: 2;
                            text: root.data.style-name;
                            accepted(value) => { root.apply("styleName", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Background"; text-color: root.text-color; }
                        LineEdit {
                            text: root.data.style-background;
                            placeholder-text: "#000000 (black)";
                            accepted(value) => { root.apply("styleBackground", value); }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 28px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.text-color.with-alpha(0.4);
                                background: root.data.style-swatch;
                            }
                            for swatch in [
                                { fill: #000000, hex: "#000000" },
                                { fill: #ffffff, hex: "#ffffff" },
                                { fill: #00b140, hex: "#00b140" },
                                { fill: #0047bb, hex: "#0047bb" },
                                { fill: #1e1e1e, hex: "#1e1e1e" },
                            ]: Rectangle {
                                width: 24px;
                                border-radius: 4px;
                                background: swatch.fill;
                                border-width: 1px;
                                border-color: root.text-color.with-alpha(0.25);
                                TouchArea { clicked => { root.apply("styleBackground", swatch.hex); } }
                            }
                        }
                    }
                    Row {
                        SettingLabel { text: "Media fit"; text-color: root.text-color; }
                        ValueCombo {
                            colspan: 2;
                            model: ["contain", "cover", "fill", "blur"];
                            value: root.data.style-fit;
                            selected(value) => { root.apply("styleFit", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Blur"; text-color: root.text-color; }
                        SpinBox {
                            enabled: root.data.style-fit == "blur";
                            minimum: 0;
                            maximum: 100;
                            value: root.data.style-blur-amount;
                            edited(value) => { root.apply("styleBlurAmount", value); }
                        }
                        SpinBox {
                            enabled: root.data.style-fit == "blur";
                            minimum: 1;
                            maximum: 100;
                            step-size: 5;
                            value: root.data.style-blur-opacity;
                            edited(value) => { root.apply("styleBlurOpacity", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Max lines"; text-color: root.text-color; }
                        SpinBox {
                            colspan: 2;
                            minimum: 0;
                            maximum: 20;
                            value: root.data.style-lines;
                            edited(value) => { root.apply("styleLines", value); }
                        }
                    }
                    Row {
                        Rectangle {}
                        Text {
                            colspan: 2;
                            text: "A style is the look of an output. Background fills the screen behind slides and when it is cleared. Blur is the radius and the opacity (%) of the blurred fill around a contained picture. Max lines splits long slides into pages; 0 shows every line. Slides that name their own style switch the output to it.";
                            color: root.text-color;
                            opacity: 0.6;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
                }
            }
            Tab {
                title: "Connection";
                VerticalLayout {
                alignment: start;
                GridLayout {
                    padding: 10px;
                    spacing: 8px;
                    Row {
                        SettingLabel { text: "Remote port"; text-color: root.text-color; }
                        SpinBox {
                            minimum: 1024;
                            maximum: 65535;
                            value: root.data.remote-port;
                            edited(value) => { root.apply("remotePort", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Stage port"; text-color: root.text-color; }
                        SpinBox {
                            minimum: 1024;
                            maximum: 65535;
                            value: root.data.stage-port;
                            edited(value) => { root.apply("stagePort", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Connections"; text-color: root.text-color; }
                        SpinBox {
                            minimum: 0;
                            maximum: 10000;
                            value: root.data.max-connections;
                            edited(value) => { root.apply("maxConnections", value); }
                        }
                    }
                    Row {
                        Text {
                            colspan: 2;
                            text: root.data.addresses;
                            wrap: word-wrap;
                            color: root.text-color;
                            font-size: 13px * OperatorStyle.font-scale;
                        }
                    }
                    Row {
                        Text {
                            colspan: 2;
                            text: "Port changes apply the next time FreeShow starts.";
                            color: root.text-color;
                            font-size: 12px * OperatorStyle.font-scale;
                        }
                    }
                }
                }
            }
            Tab {
                title: "Profiles";
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: root.data.profiles;
                        color: root.text-color;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Profiles are created in FreeShow and synced through settings_synced.json.";
                        color: root.text-color;
                        font-size: 12px * OperatorStyle.font-scale;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

export component InspectorPanel inherits VerticalLayout {
    in property <InspectorData> data;
    in property <color> text-color;
    callback set(string, string);
    // Two fields per row so the boxes fit the narrow editor column without clipping.
    spacing: 6px;
    HorizontalLayout {
        spacing: 6px;
        LineEdit {
            horizontal-stretch: 2;
            enabled: root.data.has-item;
            text: root.data.family;
            placeholder-text: "Font family";
            accepted(value) => { root.set("font-family", value); }
        }
        SpinBox {
            horizontal-stretch: 1;
            enabled: root.data.has-item;
            minimum: 12;
            maximum: 400;
            value: root.data.font-px;
            edited(value) => { root.set("font-size", value); }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        CheckBox {
            text: "Bold";
            enabled: root.data.has-item;
            checked: root.data.bold;
            toggled => { root.set("bold", Fmt.flag(self.checked)); }
        }
        CheckBox {
            text: "Italic";
            enabled: root.data.has-item;
            checked: root.data.italic;
            toggled => { root.set("italic", Fmt.flag(self.checked)); }
        }
        FieldLabel { text: "Align"; text-color: root.text-color; min-width: 40px; }
        ValueCombo {
            horizontal-stretch: 1;
            enabled: root.data.has-item;
            model: ["left", "center", "right", "justify"];
            value: root.data.align == "" ? "center" : root.data.align;
            selected(value) => { root.set("align", value); }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        FieldLabel { text: "Color"; text-color: root.text-color; min-width: 48px; }
        LineEdit {
            horizontal-stretch: 1;
            enabled: root.data.has-item;
            text: root.data.color;
            placeholder-text: "#FFFFFF";
            accepted(value) => { root.set("color", value); }
        }
        FieldLabel { text: "Fill"; text-color: root.text-color; min-width: 32px; }
        LineEdit {
            horizontal-stretch: 1;
            enabled: root.data.has-item;
            text: root.data.background;
            placeholder-text: "none";
            accepted(value) => { root.set("background-color", value); }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        FieldLabel { text: "X"; text-color: root.text-color; min-width: 48px; }
        SpinBox { horizontal-stretch: 1; enabled: root.data.has-item; minimum: -8000; maximum: 8000; value: root.data.x; edited(value) => { root.set("left", value); } }
        FieldLabel { text: "Y"; text-color: root.text-color; min-width: 32px; }
        SpinBox { horizontal-stretch: 1; enabled: root.data.has-item; minimum: -8000; maximum: 8000; value: root.data.y; edited(value) => { root.set("top", value); } }
    }
    HorizontalLayout {
        spacing: 6px;
        FieldLabel { text: "Width"; text-color: root.text-color; min-width: 48px; }
        SpinBox { horizontal-stretch: 1; enabled: root.data.has-item; minimum: 1; maximum: 8000; value: root.data.w; edited(value) => { root.set("width", value); } }
        FieldLabel { text: "Height"; text-color: root.text-color; min-width: 32px; }
        SpinBox { horizontal-stretch: 1; enabled: root.data.has-item; minimum: 1; maximum: 8000; value: root.data.h; edited(value) => { root.set("height", value); } }
    }
    HorizontalLayout {
        spacing: 6px;
        FieldLabel { text: "Radius"; text-color: root.text-color; min-width: 48px; }
        SpinBox { horizontal-stretch: 1; enabled: root.data.has-item; minimum: 0; maximum: 2000; value: root.data.radius; edited(value) => { root.set("border-radius", value); } }
        Rectangle { horizontal-stretch: 1; }
    }
}

export component StageEditorPanel inherits Rectangle {
    in property <string> layout-name;
    in property <[StageRowData]> rows;
    in property <[string]> add-kinds;
    in property <string> status;
    in-out property <int> selected: 0;
    in property <color> text-color;
    in property <color> accent;
    in property <color> accent-text;
    in property <color> close-fill;
    callback set(string, string, string);
    callback add(string);
    callback remove(string);
    callback close();
    property <StageRowData> current: root.rows[min(root.selected, root.rows.length - 1)];
    property <string> add-kind: "slide";
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        PanelHeader {
            title: "Stage editor · " + root.layout-name;
            status: root.status;
            text-color: root.text-color;
            close-fill: root.close-fill;
            close => { root.close(); }
        }
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                width: 240px;
                spacing: 6px;
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        for row[index] in root.rows: ListRow {
                            label: row.id + " · " + row.kind;
                            active: index == root.selected;
                            accent: root.accent;
                            text-color: root.text-color;
                            accent-text: root.accent-text;
                            clicked => { root.selected = index; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    ValueCombo {
                        horizontal-stretch: 1;
                        model: root.add-kinds;
                        value: root.add-kind;
                        selected(value) => { root.add-kind = value; }
                    }
                    BoxButton {
                        label: "Add item";
                        accent: root.accent;
                        text-color: root.text-color;
                        accent-text: root.accent-text;
                        clicked => { root.add(root.add-kind); }
                    }
                }
            }
            if root.rows.length > 0: VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
            GridLayout {
                    spacing: 8px;
                    Row {
                        FieldLabel { text: "Left"; text-color: root.text-color; }
                        SpinBox { minimum: -8000; maximum: 8000; value: root.current.x; edited(value) => { root.set(root.current.id, "left", value); } }
                        FieldLabel { text: "Top"; text-color: root.text-color; }
                        SpinBox { minimum: -8000; maximum: 8000; value: root.current.y; edited(value) => { root.set(root.current.id, "top", value); } }
                    }
                    Row {
                        FieldLabel { text: "Width"; text-color: root.text-color; }
                        SpinBox { minimum: 1; maximum: 8000; value: root.current.w; edited(value) => { root.set(root.current.id, "width", value); } }
                        FieldLabel { text: "Height"; text-color: root.text-color; }
                        SpinBox { minimum: 1; maximum: 8000; value: root.current.h; edited(value) => { root.set(root.current.id, "height", value); } }
                    }
                    Row {
                        FieldLabel { text: "Font size"; text-color: root.text-color; }
                        SpinBox { minimum: 8; maximum: 800; value: root.current.font-px; edited(value) => { root.set(root.current.id, "font-size", value); } }
                        FieldLabel { text: "Color"; text-color: root.text-color; }
                        LineEdit {
                            text: root.current.color;
                            placeholder-text: "#FFFFFF";
                            accepted(value) => { root.set(root.current.id, "color", value); }
                        }
                    }
                    Row {
                        BoxButton {
                            col: 3;
                            label: "Remove item";
                            accent: root.close-fill;
                            text-color: root.text-color;
                            accent-text: root.text-color;
                            clicked => { root.remove(root.current.id); }
                        }
                    }
                }
            }
        }
    }
}
