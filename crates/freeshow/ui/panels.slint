component FieldLabel inherits Text {
    in property <color> text-color;
    color: root.text-color;
    font-size: 12px * OperatorStyle.font-scale;
    vertical-alignment: center;
    min-width: 96px;
}

component SettingLabel inherits FieldLabel {
    width: 160px;
    horizontal-stretch: 0;
}

component PanelHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> status;
    in property <color> text-color;
    in property <color> close-fill;
    callback close();
    spacing: 8px;
    height: 32px;
    Text {
        text: root.title;
        color: root.text-color;
        font-size: 15px * OperatorStyle.font-scale;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        text: root.status;
        color: root.text-color;
        font-size: 12px * OperatorStyle.font-scale;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
    HeaderButton {
        label: "Close";
        accent: root.close-fill;
        text-color: root.text-color;
        accent-text: root.text-color;
        clicked => { root.close(); }
    }
}

/// Finds a value's row in a combo box model; Rust answers so Slint needs no loop.
export global ComboIndex {
    pure callback find([string], string) -> int;
}

/// Hex ↔ RGB(A) helpers wired from Rust (`parse_color` / `#{:02x}`).
export global ColorFmt {
    // a = 0…255; omits the alpha byte when a is 255.
    pure callback hex(int, int, int, int) -> string;
    pure callback parse(string) -> color;
}

/// A line edit that shows `shown` and follows it when the data changes, even after the
/// operator typed into it (typing would otherwise cut the binding).
/// Commits on Enter and when the field loses focus, so colors and style values
/// apply without hunting for Enter.
export component ValueEdit inherits LineEdit {
    in property <string> shown;
    text: self.shown;
    changed shown => { self.text = self.shown; }
    changed has-focus => {
        if !self.has-focus && self.text != self.shown {
            self.accepted(self.text);
        }
    }
}

/// Small section title for inspector / stage forms.
component SectionLabel inherits Text {
    in property <color> text-color;
    color: root.text-color;
    opacity: 0.55;
    font-size: 11px * OperatorStyle.font-scale;
    font-weight: 700;
    vertical-alignment: center;
}

/// Clickable section header that toggles `open` (▾ / ▸).
component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <color> text-color;
    in-out property <bool> open: true;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.open = !root.open; }
    height: 22px;
    border-radius: OperatorStyle.chrome-radius;
    border-width: section-focus.has-focus ? 1px : 0px;
    border-color: root.text-color.with-alpha(0.5);
    HorizontalLayout {
        spacing: OperatorStyle.space-xs;
        alignment: center;
        Text {
            text: root.open ? "▾" : "▸";
            color: root.text-color;
            opacity: 0.55;
            font-size: 11px * OperatorStyle.font-scale;
            font-weight: 700;
            vertical-alignment: center;
        }
        SectionLabel {
            text: root.title;
            text-color: root.text-color;
            horizontal-stretch: 1;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { section-focus.focus(); root.open = !root.open; }
    }
    section-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.open = !root.open;
                return accept;
            }
            reject
        }
    }
}

/// Preset chips used inside the colour picker popup.
component QuickColors inherits HorizontalLayout {
    in property <color> text-color;
    in property <bool> allow-none: false;
    in property <bool> enabled: true;
    callback pick(string);
    spacing: OperatorStyle.space-xs;
    if root.allow-none: Rectangle {
        width: 22px;
        height: 22px;
        border-radius: OperatorStyle.chrome-radius;
        border-width: 1px;
        border-color: root.text-color.with-alpha(0.35);
        background: transparent;
        Text {
            text: "∅";
            color: root.text-color;
            opacity: 0.7;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            enabled: root.enabled;
            clicked => { root.pick("none"); }
        }
    }
    for swatch in [
        { fill: #ffffff, hex: "#ffffff" },
        { fill: #f0f0ff, hex: "#f0f0ff" },
        { fill: #000000, hex: "#000000" },
        { fill: #F0008C, hex: "#F0008C" },
        { fill: #ffee00, hex: "#ffee00" },
        { fill: #00b140, hex: "#00b140" },
        { fill: #0047bb, hex: "#0047bb" },
        { fill: #c0392b, hex: "#c0392b" },
    ]: Rectangle {
        width: 22px;
        height: 22px;
        border-radius: OperatorStyle.chrome-radius;
        background: swatch.fill;
        border-width: 1px;
        border-color: root.text-color.with-alpha(0.25);
        TouchArea {
            enabled: root.enabled;
            clicked => { root.pick(swatch.hex); }
        }
    }
}

/// Swatch + hex field; click the swatch for RGBA sliders and presets.
component ColorField inherits HorizontalLayout {
    in property <string> hex;
    in property <color> text-color;
    in property <color> panel: #2a2a32;
    in property <bool> enabled: true;
    in property <bool> allow-none: false;
    in property <string> placeholder: "#ffffff";
    callback set(string);
    spacing: OperatorStyle.space-xs;
    horizontal-stretch: 1;
    alignment: center;
    property <color> live: ColorFmt.parse(root.hex);
    property <bool> empty: root.hex == "" || root.hex == "none" || root.hex == "transparent";
    property <int> r: root.empty ? 255 : round(root.live.red * 255);
    property <int> g: root.empty ? 255 : round(root.live.green * 255);
    property <int> b: root.empty ? 255 : round(root.live.blue * 255);
    property <int> a: root.empty ? 255 : round(root.live.alpha * 255);

    swatch := Rectangle {
        width: OperatorStyle.swatch-size;
        height: OperatorStyle.swatch-size;
        border-radius: OperatorStyle.chrome-radius;
        border-width: 1px;
        border-color: root.text-color.with-alpha(0.35);
        background: root.empty ? transparent : root.live;
        if root.empty: Text {
            text: "∅";
            color: root.text-color;
            opacity: 0.55;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { picker.show(); }
        }
        picker := PopupWindow {
            x: 0px;
            y: parent.height + OperatorStyle.space-xs;
            width: 256px;
            close-policy: close-on-click-outside;
            Rectangle {
                background: root.panel;
                border-radius: OperatorStyle.chrome-radius;
                border-width: 1px;
                border-color: root.text-color.with-alpha(0.22);
                VerticalLayout {
                    padding: OperatorStyle.space;
                    spacing: OperatorStyle.space-sm;
                    Rectangle {
                        height: 40px;
                        border-radius: OperatorStyle.chrome-radius;
                        border-width: 1px;
                        border-color: root.text-color.with-alpha(0.25);
                        background: root.empty ? transparent : root.live;
                    }
                    HorizontalLayout {
                        spacing: OperatorStyle.space-xs;
                        Text {
                            text: "R";
                            color: root.text-color;
                            min-width: 14px;
                            vertical-alignment: center;
                        }
                        Slider {
                            horizontal-stretch: 1;
                            minimum: 0;
                            maximum: 255;
                            value: root.r;
                            changed(value) => {
                                root.set(ColorFmt.hex(round(value), root.g, root.b, root.a));
                            }
                        }
                        Text {
                            text: root.r;
                            color: root.text-color;
                            min-width: 28px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: OperatorStyle.space-xs;
                        Text {
                            text: "G";
                            color: root.text-color;
                            min-width: 14px;
                            vertical-alignment: center;
                        }
                        Slider {
                            horizontal-stretch: 1;
                            minimum: 0;
                            maximum: 255;
                            value: root.g;
                            changed(value) => {
                                root.set(ColorFmt.hex(root.r, round(value), root.b, root.a));
                            }
                        }
                        Text {
                            text: root.g;
                            color: root.text-color;
                            min-width: 28px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: OperatorStyle.space-xs;
                        Text {
                            text: "B";
                            color: root.text-color;
                            min-width: 14px;
                            vertical-alignment: center;
                        }
                        Slider {
                            horizontal-stretch: 1;
                            minimum: 0;
                            maximum: 255;
                            value: root.b;
                            changed(value) => {
                                root.set(ColorFmt.hex(root.r, root.g, round(value), root.a));
                            }
                        }
                        Text {
                            text: root.b;
                            color: root.text-color;
                            min-width: 28px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: OperatorStyle.space-xs;
                        Text {
                            text: "A";
                            color: root.text-color;
                            min-width: 14px;
                            vertical-alignment: center;
                        }
                        Slider {
                            horizontal-stretch: 1;
                            minimum: 0;
                            maximum: 255;
                            value: root.a;
                            changed(value) => {
                                root.set(ColorFmt.hex(root.r, root.g, root.b, round(value)));
                            }
                        }
                        Text {
                            text: root.a;
                            color: root.text-color;
                            min-width: 28px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    QuickColors {
                        text-color: root.text-color;
                        allow-none: root.allow-none;
                        enabled: root.enabled;
                        pick(hex) => { root.set(hex); }
                    }
                }
            }
        }
    }
    ValueEdit {
        horizontal-stretch: 1;
        enabled: root.enabled;
        shown: root.hex;
        placeholder-text: root.placeholder;
        accepted(value) => { root.set(value); }
    }
}

/// A spin box that shows `shown` and follows it when the data changes, even after the
/// operator typed into it (which would otherwise cut the binding).
component ValueSpin inherits SpinBox {
    in property <int> shown;
    value: self.shown;
    changed shown => { self.value = self.shown; }
}

/// Checkbox that follows `shown` when the bound data changes (std CheckBox sticks after a click).
component ValueCheck inherits CheckBox {
    in property <bool> shown;
    checked: self.shown;
    changed shown => { self.checked = self.shown; }
}

/// Switch that follows `shown` when the bound data changes (std Switch sticks after a click).
component ValueSwitch inherits Switch {
    in property <bool> shown;
    checked: self.shown;
    changed shown => { self.checked = self.shown; }
}

/// A combo box that shows `value` and follows it when the data changes, even after the
/// operator picked a row or the model was replaced (which resets std ComboBox to row 0).
component ValueCombo inherits ComboBox {
    in property <string> value;
    current-index: ComboIndex.find(self.model, self.value);
    changed value => { self.follow(); }
    changed model => { self.follow(); }
    // Setting the index alone can leave the shown text on the old row, so set both.
    public function follow() {
        self.current-index = ComboIndex.find(self.model, self.value);
        self.current-value = self.current-index >= 0 ? self.model[self.current-index] : self.value;
    }
}

global Fmt {
    public pure function flag(on: bool) -> string {
        return on ? "true" : "false";
    }
}

export struct AudioCheckRow {
    source: string,
    destination: string,
    detail: string,
}

export struct AudioMappingRow {
    key: string,
    choice: string,
    choices: [string],
    pending: bool,
}

export struct NetworkCheckRow {
    transport: string,
    output: string,
    picture: string,
    status: string,
}

export component SettingsPanel inherits Rectangle {
    in property <SettingsData> data;
    in property <string> remote-web-status;
    in property <string> stage-web-status;
    in property <string> audio-check-status;
    in property <[AudioCheckRow]> audio-check-rows;
    in property <[AudioMappingRow]> audio-mapping-rows;
    in property <bool> audio-scan-running;
    in property <[NetworkCheckRow]> network-check-rows;
    callback scan-audio-devices();
    callback save-audio-mapping(string, string);
    in property <[string]> themes;
    in property <[string]> autosave-choices;
    in property <[string]> transition-kinds;
    in property <string> status;
    in property <color> text-color;
    in property <color> close-fill;
    in property <color> panel: #2a2a32;
    callback apply(string, string);
    callback save-icecast(string, string, string, string, string, bool) -> bool;
    callback close();
    VerticalLayout {
        padding: OperatorStyle.panel-pad;
        spacing: OperatorStyle.space-sm;
        PanelHeader {
            title: "Settings";
            status: root.status;
            text-color: root.text-color;
            close-fill: root.close-fill;
            close => { root.close(); }
        }
        TabWidget {
            Tab {
                title: "General";
                VerticalLayout {
                alignment: start;
                GridLayout {
                    padding: OperatorStyle.panel-pad;
                    spacing: 8px;
                    Row {
                        SettingLabel { text: "Language"; text-color: root.text-color; }
                        // The languages the operator labels are translated into.
                        ValueCombo {
                            model: ["en", "de", "es", "fr", "nb"];
                            value: root.data.language;
                            selected(value) => { root.apply("language", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Time format"; text-color: root.text-color; }
                        ValueCombo {
                            model: ["24", "12"];
                            value: root.data.time-format;
                            selected(value) => { root.apply("timeFormat", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Autosave"; text-color: root.text-color; }
                        ValueCombo {
                            model: root.autosave-choices;
                            value: root.data.autosave;
                            selected(value) => { root.apply("autosave", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Updates"; text-color: root.text-color; }
                        ValueSwitch {
                            text: "Alert when a new version is released";
                            shown: root.data.alert-updates;
                            toggled => { root.apply("alertUpdates", Fmt.flag(self.checked)); }
                        }
                    }
                }
                }
            }
            Tab {
                title: "Display";
                VerticalLayout {
                alignment: start;
                GridLayout {
                    padding: OperatorStyle.panel-pad;
                    spacing: 8px;
                    Row {
                        SettingLabel { text: "Outputs"; text-color: root.text-color; }
                        ValueSwitch {
                            text: "Open output on startup";
                            shown: root.data.auto-output;
                            toggled => { root.apply("autoOutput", Fmt.flag(self.checked)); }
                        }
                        ValueSwitch {
                            text: "Lock output";
                            shown: root.data.out-locked;
                            toggled => { root.apply("outLocked", Fmt.flag(self.checked)); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Slides"; text-color: root.text-color; }
                        ValueSwitch {
                            text: "Full group colors";
                            shown: root.data.full-colors;
                            toggled => { root.apply("fullColors", Fmt.flag(self.checked)); }
                        }
                        ValueSwitch {
                            text: "Group numbers";
                            shown: root.data.group-numbers;
                            toggled => { root.apply("groupNumbers", Fmt.flag(self.checked)); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Labels"; text-color: root.text-color; }
                        ValueSwitch {
                            text: "Hide button labels";
                            shown: root.data.labels-disabled;
                            toggled => { root.apply("labelsDisabled", Fmt.flag(self.checked)); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Split lines"; text-color: root.text-color; }
                        ValueSpin {
                            colspan: 2;
                            minimum: 0;
                            maximum: 20;
                            shown: root.data.split-lines;
                            edited(value) => { root.apply("splitLines", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Slide transition"; text-color: root.text-color; }
                        ValueCombo {
                            model: root.transition-kinds;
                            value: root.data.text-transition;
                            selected(value) => { root.apply("textTransition", value); }
                        }
                        ValueSpin {
                            minimum: 0;
                            maximum: 10000;
                            step-size: 100;
                            shown: root.data.text-duration;
                            edited(value) => { root.apply("textDuration", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Slide direction"; text-color: root.text-color; }
                        ValueCombo {
                            colspan: 2;
                            model: ["left_right", "right_left", "top_bottom", "bottom_top", "up_left", "up_right", "down_left", "down_right"];
                            value: root.data.text-direction == "" ? "left_right" : root.data.text-direction;
                            selected(value) => { root.apply("textDirection", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Media transition"; text-color: root.text-color; }
                        ValueCombo {
                            model: root.transition-kinds;
                            value: root.data.media-transition;
                            selected(value) => { root.apply("mediaTransition", value); }
                        }
                        ValueSpin {
                            minimum: 0;
                            maximum: 10000;
                            step-size: 100;
                            shown: root.data.media-duration;
                            edited(value) => { root.apply("mediaDuration", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Media direction"; text-color: root.text-color; }
                        ValueCombo {
                            colspan: 2;
                            model: ["left_right", "right_left", "top_bottom", "bottom_top", "up_left", "up_right", "down_left", "down_right"];
                            value: root.data.media-direction == "" ? "left_right" : root.data.media-direction;
                            selected(value) => { root.apply("mediaDirection", value); }
                        }
                    }
                    Row {
                        Rectangle {}
                        Text {
                            colspan: 2;
                            text: "Durations are in milliseconds. Direction applies to slide, wipe, push, cover, and uncover. A show or slide with its own transition keeps it.";
                            color: root.text-color;
                            opacity: 0.6;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
                }
            }
            Tab {
                title: "Theme";
                VerticalLayout {
                alignment: start;
                GridLayout {
                    padding: OperatorStyle.panel-pad;
                    spacing: 8px;
                    Row {
                        SettingLabel { text: "Theme"; text-color: root.text-color; }
                        ValueCombo {
                            model: root.themes;
                            value: root.data.theme;
                            selected(value) => { root.apply("theme", value); }
                        }
                        HorizontalLayout {
                            spacing: OperatorStyle.space-sm;
                            Button {
                                text: "Duplicate";
                                clicked => { root.apply("themeDuplicate", ""); }
                            }
                            Button {
                                text: "Reset";
                                enabled: root.data.theme-edited;
                                clicked => { root.apply("themeReset", ""); }
                            }
                        }
                    }
                    for row in root.data.theme-colors: Row {
                        SettingLabel { text: row.label; text-color: root.text-color; }
                        ColorField {
                            colspan: 2;
                            hex: row.hex;
                            text-color: root.text-color;
                            panel: root.panel;
                            set(value) => { root.apply("themeColor." + row.key, value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Font"; text-color: root.text-color; }
                        ValueEdit {
                            colspan: 2;
                            shown: root.data.theme-font;
                            placeholder-text: "System font";
                            accepted(value) => { root.apply("themeFont", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Text size %"; text-color: root.text-color; }
                        ValueSpin {
                            minimum: 50;
                            maximum: 200;
                            step-size: 5;
                            shown: root.data.theme-font-size;
                            edited(value) => { root.apply("themeFontSize", value); }
                        }
                        HorizontalLayout {
                            spacing: OperatorStyle.space-sm;
                            SettingLabel { text: "Corners px"; text-color: root.text-color; }
                            ValueSpin {
                                minimum: 0;
                                maximum: 24;
                                shown: root.data.theme-radius;
                                edited(value) => { root.apply("themeRadius", value); }
                            }
                        }
                    }
                    Row {
                        Rectangle {}
                        Text {
                            colspan: 2;
                            text: "Type a colour such as #242832 and press Enter; the window updates at once. Edits are saved to Config/themes.json. Duplicate makes your own copy of this theme; Reset drops your edits.";
                            color: root.text-color;
                            opacity: 0.6;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
                }
            }
            Tab {
                title: "Outputs";
                VerticalLayout {
                alignment: start;
                GridLayout {
                    padding: OperatorStyle.panel-pad;
                    spacing: 8px;
                    Row {
                        SettingLabel { text: "Output"; text-color: root.text-color; }
                        ValueCombo {
                            model: root.data.output-names;
                            value: root.data.output-name;
                            selected(value) => { root.apply("outputPick", value); }
                        }
                        HorizontalLayout {
                            spacing: OperatorStyle.space-sm;
                            Button {
                                text: "New output";
                                clicked => { root.apply("outputNew", ""); }
                            }
                            Button {
                                text: "Delete output";
                                enabled: root.data.output-names.length > 1;
                                clicked => { root.apply("outputDelete", ""); }
                            }
                        }
                    }
                    Row {
                        SettingLabel { text: "Name"; text-color: root.text-color; }
                        ValueEdit {
                            colspan: 2;
                            shown: root.data.output-name;
                            placeholder-text: "Primary";
                            accepted(value) => { root.apply("outputName", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Style"; text-color: root.text-color; }
                        ValueCombo {
                            colspan: 2;
                            model: root.data.style-names;
                            value: root.data.style-name;
                            selected(value) => { root.apply("outputStyle", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Resolution"; text-color: root.text-color; }
                        ValueCombo {
                            colspan: 2;
                            // Slides are 16:9, so these sizes keep that shape.
                            model: ["1920x1080", "1280x720", "2560x1440", "3840x2160"];
                            value: root.data.output-resolution;
                            selected(value) => { root.apply("outputResolution", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Window"; text-color: root.text-color; }
                        ValueSwitch {
                            text: "Always on top";
                            shown: root.data.output-always-on-top;
                            toggled => { root.apply("outputAlwaysOnTop", Fmt.flag(self.checked)); }
                        }
                        ValueSwitch {
                            text: "Kiosk (fullscreen)";
                            shown: root.data.output-kiosk;
                            toggled => { root.apply("outputKiosk", Fmt.flag(self.checked)); }
                        }
                    }
                    Row {
                        Rectangle {}
                        Text {
                            colspan: 2;
                            text: "The output window plays the output picked here, with its style and window options. Screen in the header moves it to another monitor. A new resolution applies the next time FreeShow starts. Stage displays are set up in Stage edit.";
                            color: root.text-color;
                            opacity: 0.6;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
                }
            }
            Tab {
                title: "Styles";
                VerticalLayout {
                alignment: start;
                GridLayout {
                    padding: OperatorStyle.panel-pad;
                    spacing: 8px;
                    Row {
                        SettingLabel { text: "Output style"; text-color: root.text-color; }
                        ValueCombo {
                            model: root.data.style-names;
                            value: root.data.style-name;
                            selected(value) => { root.apply("outputStyle", value); }
                        }
                        HorizontalLayout {
                            spacing: OperatorStyle.space-sm;
                            Button {
                                text: "New style";
                                clicked => { root.apply("styleNew", ""); }
                            }
                            Button {
                                text: "Delete style";
                                enabled: !root.data.style-is-default;
                                clicked => { root.apply("styleDelete", ""); }
                            }
                        }
                    }
                    Row {
                        SettingLabel { text: "Name"; text-color: root.text-color; }
                        ValueEdit {
                            colspan: 2;
                            shown: root.data.style-name;
                            accepted(value) => { root.apply("styleName", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Background"; text-color: root.text-color; }
                        ColorField {
                            colspan: 2;
                            hex: root.data.style-background;
                            text-color: root.text-color;
                            panel: root.panel;
                            placeholder: "#000000 (black)";
                            set(value) => { root.apply("styleBackground", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Media fit"; text-color: root.text-color; }
                        ValueCombo {
                            colspan: 2;
                            model: ["contain", "cover", "fill", "blur"];
                            value: root.data.style-fit;
                            selected(value) => { root.apply("styleFit", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Blur"; text-color: root.text-color; }
                        ValueSpin {
                            enabled: root.data.style-fit == "blur";
                            minimum: 0;
                            maximum: 100;
                            shown: root.data.style-blur-amount;
                            edited(value) => { root.apply("styleBlurAmount", value); }
                        }
                        ValueSpin {
                            enabled: root.data.style-fit == "blur";
                            minimum: 1;
                            maximum: 100;
                            step-size: 5;
                            shown: root.data.style-blur-opacity;
                            edited(value) => { root.apply("styleBlurOpacity", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Max lines"; text-color: root.text-color; }
                        ValueSpin {
                            colspan: 2;
                            minimum: 0;
                            maximum: 20;
                            shown: root.data.style-lines;
                            edited(value) => { root.apply("styleLines", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Template"; text-color: root.text-color; }
                        ValueCombo {
                            colspan: 2;
                            model: root.data.template-choices;
                            value: root.data.style-template;
                            selected(value) => { root.apply("styleTemplate", value); }
                        }
                    }
                    Row {
                        Rectangle {}
                        Text {
                            colspan: 2;
                            text: "A style is the look of an output. Background fills the screen behind slides and when it is cleared. Blur is the radius and the opacity (%) of the blurred fill around a contained picture. Max lines splits long slides into pages; 0 shows every line. A template lays out every slide on this output in its text look without changing the shows. Slides that name their own style switch the output to it.";
                            color: root.text-color;
                            opacity: 0.6;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
                }
            }
            Tab {
                title: "Connection";
                VerticalLayout {
                alignment: start;
                GridLayout {
                    padding: OperatorStyle.panel-pad;
                    spacing: 8px;
                    Row {
                        SettingLabel { text: "Remote port"; text-color: root.text-color; }
                        ValueSpin {
                            minimum: 1024;
                            maximum: 65535;
                            shown: root.data.remote-port;
                            edited(value) => { root.apply("remotePort", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Remote password"; text-color: root.text-color; }
                        ValueEdit {
                            shown: root.data.remote-password;
                            placeholder-text: "Blank = no password";
                            input-type: password;
                            accepted(value) => { root.apply("remotePassword", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Stage port"; text-color: root.text-color; }
                        ValueSpin {
                            minimum: 1024;
                            maximum: 65535;
                            shown: root.data.stage-port;
                            edited(value) => { root.apply("stagePort", value); }
                        }
                    }
                    Row {
                        SettingLabel { text: "Connections"; text-color: root.text-color; }
                        ValueSpin {
                            minimum: 0;
                            maximum: 10000;
                            shown: root.data.max-connections;
                            edited(value) => { root.apply("maxConnections", value); }
                        }
                    }
                    Row {
                        Text {
                            colspan: 2;
                            text: root.remote-web-status;
                            accessible-role: text;
                            accessible-label: "Phone remote listener status";
                            accessible-value: root.remote-web-status;
                            wrap: word-wrap;
                            color: root.text-color;
                            font-size: 13px * OperatorStyle.font-scale;
                        }
                    }
                    Row {
                        Text {
                            colspan: 2;
                            text: root.stage-web-status;
                            accessible-role: text;
                            accessible-label: "Stage web listener status";
                            accessible-value: root.stage-web-status;
                            wrap: word-wrap;
                            color: root.text-color;
                            font-size: 13px * OperatorStyle.font-scale;
                        }
                    }
                    Row {
                        Text {
                            colspan: 2;
                            text: "Open these addresses from a device on the same network. Connection settings apply after restart.";
                            color: root.text-color;
                            font-size: 12px * OperatorStyle.font-scale;
                        }
                    }
                }
                }
            }
            Tab {
                title: "Audio routing";
                VerticalLayout {
                    padding: OperatorStyle.panel-pad;
                    spacing: OperatorStyle.space-sm;
                    HorizontalLayout {
                        spacing: OperatorStyle.space;
                        Button {
                            text: "Scan output devices";
                            enabled: !root.audio-scan-running;
                            clicked => { root.scan-audio-devices(); }
                        }
                        Text {
                            text: root.audio-check-status;
                            accessible-role: text;
                            accessible-label: "Audio scan status";
                            accessible-value: root.audio-check-status;
                            color: root.text-color;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                    ScrollView {
                        content-height: max(self.visible-height, audio-check.min-height);
                        audio-check := VerticalLayout {
                            width: parent.width - 18px;
                            padding-top: OperatorStyle.space-sm;
                            spacing: OperatorStyle.space-sm;
                            alignment: start;
                            for route in root.audio-check-rows: VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: route.source + " → " + route.destination;
                                    color: root.text-color;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: route.detail;
                                    color: root.text-color;
                                    opacity: 0.75;
                                    wrap: word-wrap;
                                }
                            }
                            if root.audio-mapping-rows.length > 0: Text {
                                text: "Device mappings";
                                color: root.text-color;
                                font-weight: 600;
                            }
                            if root.audio-mapping-rows.length > 0: Text {
                                text: "The picker shows devices listed for every playback path using that speaker. Saved mappings apply after restart.";
                                color: root.text-color;
                                opacity: 0.75;
                                wrap: word-wrap;
                            }
                            for mapping in root.audio-mapping-rows: HorizontalLayout {
                                spacing: OperatorStyle.space-sm;
                                Text {
                                    text: mapping.key + (mapping.pending ? " · Applies after restart" : "");
                                    color: root.text-color;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }
                                ValueCombo {
                                    horizontal-stretch: 1;
                                    enabled: !root.audio-scan-running;
                                    accessible-label: "Native device for " + mapping.key;
                                    model: mapping.choices;
                                    value: mapping.choice;
                                    selected(value) => {
                                        root.save-audio-mapping(mapping.key, self.current-index == 0 ? "" : value);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Tab {
                title: "Network outputs";
                ScrollView {
                    content-height: max(self.visible-height, network-check.min-height);
                    network-check := VerticalLayout {
                        width: parent.width - 18px;
                        padding: OperatorStyle.panel-pad;
                        spacing: OperatorStyle.space-sm;
                        alignment: start;
                        if root.network-check-rows.length == 0: Text {
                            text: "No network outputs are configured for this session.";
                            color: root.text-color;
                            wrap: word-wrap;
                        }
                        for route in root.network-check-rows: VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: route.transport + " · " + route.output + " · " + route.picture;
                                color: root.text-color;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                            Text {
                                text: route.status;
                                accessible-role: text;
                                accessible-label: route.transport + " status for " + route.output;
                                accessible-value: route.status;
                                color: root.text-color;
                                opacity: 0.8;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
            Tab {
                title: "Icecast";
                ScrollView {
                    content-height: max(self.visible-height, icecast-form.min-height);
                    VerticalLayout {
                        alignment: start;
                        icecast-form := GridLayout {
                            padding: OperatorStyle.panel-pad;
                            spacing: 8px;
                            Row {
                                SettingLabel { text: "Host"; text-color: root.text-color; }
                                icecast-host := ValueEdit {
                                    shown: root.data.icecast-host;
                                    accessible-label: "Icecast host";
                                    enabled: root.data.has-library;
                                }
                            }
                            Row {
                                SettingLabel { text: "Port"; text-color: root.text-color; }
                                icecast-port := ValueEdit {
                                    shown: root.data.icecast-port;
                                    input-type: number;
                                    accessible-label: "Icecast port";
                                    enabled: root.data.has-library;
                                }
                            }
                            Row {
                                SettingLabel { text: "Mount"; text-color: root.text-color; }
                                icecast-mount := ValueEdit {
                                    shown: root.data.icecast-mount;
                                    accessible-label: "Icecast mount";
                                    enabled: root.data.has-library;
                                }
                            }
                            Row {
                                SettingLabel { text: "Source password"; text-color: root.text-color; }
                                icecast-password := LineEdit {
                                    input-type: password;
                                    placeholder-text: "Leave blank to keep the current password";
                                    accessible-label: "Icecast source password";
                                    enabled: root.data.has-library;
                                }
                            }
                            Row {
                                SettingLabel { text: "Transport"; text-color: root.text-color; }
                                icecast-transport := ValueCombo {
                                    model: ["Automatic", "HTTP", "TLS"];
                                    value: root.data.icecast-transport;
                                    accessible-label: "Icecast transport";
                                    enabled: root.data.has-library;
                                }
                            }
                            Row {
                                SettingLabel { text: "Audio routing"; text-color: root.text-color; }
                                icecast-main := ValueCheck {
                                    text: "Use Main mix when no Icecast route is saved";
                                    shown: root.data.icecast-main-mix;
                                    enabled: root.data.has-library;
                                }
                            }
                            Row {
                                Rectangle {}
                                Text {
                                    text: !root.data.has-library ? "Choose a library folder to configure Icecast." :
                                        root.data.icecast-routed ? "Start or stop streaming from Functions." :
                                        "Choose Main mix or add a library audio route to Icecast.";
                                    color: root.text-color;
                                    wrap: word-wrap;
                                    font-size: 12px * OperatorStyle.font-scale;
                                }
                            }
                            Row {
                                Rectangle {}
                                HorizontalLayout {
                                    Button {
                                        text: "Save connection";
                                        enabled: root.data.has-library;
                                        clicked => {
                                            if root.save-icecast(icecast-host.text, icecast-port.text,
                                                icecast-mount.text, icecast-password.text, icecast-transport.current-value, icecast-main.checked) {
                                                icecast-password.text = "";
                                            }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }
            }
            Tab {
                title: "Profiles";
                VerticalLayout {
                    padding: OperatorStyle.panel-pad;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: root.data.profiles;
                        color: root.text-color;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Profiles are created in FreeShow and synced through settings_synced.json.";
                        color: root.text-color;
                        font-size: 12px * OperatorStyle.font-scale;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

export component InspectorPanel inherits VerticalLayout {
    in property <InspectorData> data;
    in property <bool> item-locked;
    private property <bool> item-editable: root.data.has-item && !root.item-locked;
    in property <color> text-color;
    in property <color> panel: #2a2a32;
    in property <color> accent: #4f63df;
    in property <color> accent-text: white;
    in property <[BuildRowData]> build-rows;
    in property <int> selected-layer: -1;
    in property <int> transition-slide-count;
    callback preview-transition();
    callback preview-builds();
    callback choose-build-layer(int);
    callback apply-transition-range(int, int);
    private property <bool> show-transition-range;
    private property <[string]> effect-keys: ["default", "none", "fade", "blur", "scale", "slide", "spin", "push", "fade_through_black", "wipe", "cover", "uncover"];
    private property <[string]> effect-labels: ["Inherited", "Cut", "Fade", "Blur", "Scale", "Slide", "Spin", "Push", "Fade through black", "Wipe", "Cover", "Uncover"];
    private property <[string]> direction-keys: ["left_right", "right_left", "top_bottom", "bottom_top", "up_left", "up_right", "down_left", "down_right"];
    private property <[string]> direction-labels: ["Left to right", "Right to left", "Top to bottom", "Bottom to top", "Up left", "Up right", "Down left", "Down right"];
    private property <[string]> easing-keys: ["linear", "sine", "cubic", "circ", "back", "elastic", "bounce"];
    private property <[string]> easing-labels: ["Linear", "Smooth", "Cubic", "Circular", "Overshoot", "Elastic", "Bounce"];
    private property <bool> has-direction: root.choice-index(["slide", "push", "wipe", "cover", "uncover"], root.data.slide-transition) >= 0;
    private property <int> effective-effect: root.choice-index(root.effect-keys, root.data.slide-transition);
    private property <bool> inherited: root.data.slide-transition-source != "This slide";
    pure function choice-index(model: [string], value: string) -> int {
        let index = ComboIndex.find(model, value);
        return index >= 0 && index < model.length && model[index] == value ? index : -1;
    }

    callback set(string, string);
    // Rare mid-service sections start collapsed so Text/Position stay on screen.
    property <bool> open-text: true;
    property <bool> open-position: true;
    property <bool> open-picture: true;
    property <bool> open-box: false;
    property <bool> open-outline: false;
    property <bool> open-filters: false;
    property <bool> open-layout: false;
    property <bool> open-build: false;
    property <bool> open-transition: true;
    spacing: OperatorStyle.space-sm;

    SectionHeader { title: "TEXT"; text-color: root.text-color; open <=> root.open-text; }
    if root.open-text: VerticalLayout {
        spacing: OperatorStyle.space-sm;
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            ValueEdit {
                horizontal-stretch: 2;
                enabled: root.item-editable;
                shown: root.data.family;
                placeholder-text: "Font family";
                accepted(value) => { root.set("font-family", value); }
            }
            ValueSpin {
                horizontal-stretch: 1;
                enabled: root.item-editable;
                minimum: 12;
                maximum: 400;
                shown: root.data.font-px;
                edited(value) => { root.set("font-size", value); }
            }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            ValueCheck {
                text: "Bold";
                enabled: root.item-editable;
                shown: root.data.bold;
                toggled => { root.set("bold", Fmt.flag(self.checked)); }
            }
            ValueCheck {
                text: "Italic";
                enabled: root.item-editable;
                shown: root.data.italic;
                toggled => { root.set("italic", Fmt.flag(self.checked)); }
            }
            FieldLabel { text: "Align"; text-color: root.text-color; min-width: 40px; }
            ValueCombo {
                horizontal-stretch: 1;
                enabled: root.item-editable;
                model: ["left", "center", "right", "justify"];
                value: root.data.align == "" ? "center" : root.data.align;
                selected(value) => { root.set("align", value); }
            }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            ValueCheck {
                text: "Underline";
                enabled: root.item-editable;
                shown: root.data.underline;
                toggled => { root.set("underline", Fmt.flag(self.checked)); }
            }
            ValueCheck {
                text: "Strikethrough";
                enabled: root.item-editable;
                shown: root.data.strike;
                toggled => { root.set("line-through", Fmt.flag(self.checked)); }
            }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Color"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ColorField {
                hex: root.data.color;
                text-color: root.text-color;
                panel: root.panel;
                enabled: root.item-editable;
                placeholder: "#FFFFFF";
                set(value) => { root.set("color", value); }
            }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Fill"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ColorField {
                hex: root.data.background;
                text-color: root.text-color;
                panel: root.panel;
                enabled: root.item-editable;
                allow-none: true;
                placeholder: "none";
                set(value) => { root.set("background-color", value); }
            }
        }
    }

    SectionHeader { title: "POSITION"; text-color: root.text-color; open <=> root.open-position; }
    if root.open-position: VerticalLayout {
        spacing: OperatorStyle.space-sm;
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "X"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: -8000; maximum: 8000; shown: root.data.x; edited(value) => { root.set("left", value); } }
            FieldLabel { text: "Y"; text-color: root.text-color; min-width: 32px; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: -8000; maximum: 8000; shown: root.data.y; edited(value) => { root.set("top", value); } }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Width"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 1; maximum: 8000; shown: root.data.w; edited(value) => { root.set("width", value); } }
            FieldLabel { text: "Height"; text-color: root.text-color; min-width: 32px; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 1; maximum: 8000; shown: root.data.h; edited(value) => { root.set("height", value); } }
        }
    }

    if root.data.has-item && root.data.has-picture: VerticalLayout {
        spacing: OperatorStyle.space-sm;
        SectionHeader { title: "PICTURE"; text-color: root.text-color; open <=> root.open-picture; }
        if root.open-picture: VerticalLayout {
            spacing: OperatorStyle.space-sm;
            HorizontalLayout {
                spacing: OperatorStyle.space-sm;
                FieldLabel { text: "Picture fit"; text-color: root.text-color; }
                ValueCombo {
                    horizontal-stretch: 1;
                    model: ["contain", "cover", "fill", "tile"];
                    value: root.data.picture-fit == "blur" || root.data.picture-fit == "" ? "contain" : root.data.picture-fit;
                    selected(value) => { root.set("picture-fit", value); }
                }
            }
            HorizontalLayout {
                spacing: OperatorStyle.space-sm;
                ValueCheck {
                    text: "Flip horizontally";
                    shown: root.data.picture-flip-x;
                    toggled => { root.set("picture-flip-x", Fmt.flag(self.checked)); }
                }
                ValueCheck {
                    text: "Flip vertically";
                    shown: root.data.picture-flip-y;
                    toggled => { root.set("picture-flip-y", Fmt.flag(self.checked)); }
                }
            }
            FieldLabel { text: "Picture crop (%)"; text-color: root.text-color; }
            HorizontalLayout {
                spacing: OperatorStyle.space-sm;
                FieldLabel { text: "Left"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
                ValueEdit { horizontal-stretch: 1; shown: root.data.crop-left; accepted(value) => { root.set("crop-left", value); } }
                FieldLabel { text: "Right"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
                ValueEdit { horizontal-stretch: 1; shown: root.data.crop-right; accepted(value) => { root.set("crop-right", value); } }
            }
            HorizontalLayout {
                spacing: OperatorStyle.space-sm;
                FieldLabel { text: "Top"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
                ValueEdit { horizontal-stretch: 1; shown: root.data.crop-top; accepted(value) => { root.set("crop-top", value); } }
                FieldLabel { text: "Bottom"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
                ValueEdit { horizontal-stretch: 1; shown: root.data.crop-bottom; accepted(value) => { root.set("crop-bottom", value); } }
            }
        }
    }

    SectionHeader { title: "BOX"; text-color: root.text-color; open <=> root.open-box; }
    if root.open-box: VerticalLayout {
        spacing: OperatorStyle.space-sm;
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Box shadow"; text-color: root.text-color; }
            ValueEdit {
                horizontal-stretch: 1;
                enabled: root.item-editable;
                shown: root.data.box-shadow;
                placeholder-text: "0 4px 12px #0008";
                accepted(value) => { root.set("box-shadow", value); }
            }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Backdrop filter"; text-color: root.text-color; }
            ValueEdit {
                horizontal-stretch: 1;
                enabled: root.item-editable;
                shown: root.data.backdrop-filter;
                placeholder-text: "blur(8px)";
                accepted(value) => { root.set("backdrop-filter", value); }
            }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Radius"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueEdit {
                horizontal-stretch: 1;
                enabled: root.item-editable;
                shown: root.data.radius;
                placeholder-text: "0";
                accepted(value) => { root.set("border-radius", value); }
            }
            FieldLabel { text: "Line %"; text-color: root.text-color; min-width: 32px; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 500; step-size: 5; shown: root.data.line-height; edited(value) => { root.set("line-height", value); } }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Spacing"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: -300; maximum: 100; shown: root.data.letter-spacing; edited(value) => { root.set("letter-spacing", value); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    SectionHeader { title: "OUTLINE & SHADOW"; text-color: root.text-color; open <=> root.open-outline; }
    if root.open-outline: VerticalLayout {
        spacing: OperatorStyle.space-sm;
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Outline"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 100; shown: root.data.outline-width; edited(value) => { root.set("outline-width", value); } }
            ColorField {
                hex: root.data.outline-color;
                text-color: root.text-color;
                panel: root.panel;
                enabled: root.item-editable;
                placeholder: "#000000";
                set(value) => { root.set("outline-color", value); }
            }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Shadow"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 500; shown: root.data.shadow-blur; edited(value) => { root.set("shadow-blur", value); } }
            ColorField {
                hex: root.data.shadow-color;
                text-color: root.text-color;
                panel: root.panel;
                enabled: root.item-editable;
                placeholder: "#000000";
                set(value) => { root.set("shadow-color", value); }
            }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Shadow X"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: -1000; maximum: 1000; shown: root.data.shadow-x; edited(value) => { root.set("shadow-x", value); } }
            FieldLabel { text: "Y"; text-color: root.text-color; min-width: 32px; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: -1000; maximum: 1000; shown: root.data.shadow-y; edited(value) => { root.set("shadow-y", value); } }
        }
    }

    SectionHeader { title: "FILTERS"; text-color: root.text-color; open <=> root.open-filters; }
    if root.open-filters: VerticalLayout {
        spacing: OperatorStyle.space-sm;
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Blur"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 100; step-size: 1; shown: root.data.blur; edited(value) => { root.set("blur", value); } }
            FieldLabel { text: "Gray %"; text-color: root.text-color; min-width: 32px; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 100; step-size: 1; shown: root.data.grayscale; edited(value) => { root.set("grayscale", value); } }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Bright %"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 500; step-size: 5; shown: root.data.brightness; edited(value) => { root.set("brightness", value); } }
            FieldLabel { text: "Contr %"; text-color: root.text-color; min-width: 32px; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 500; step-size: 5; shown: root.data.contrast; edited(value) => { root.set("contrast", value); } }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Satur %"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 500; step-size: 5; shown: root.data.saturate; edited(value) => { root.set("saturate", value); } }
            FieldLabel { text: "Hue °"; text-color: root.text-color; min-width: 32px; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 360; step-size: 5; shown: root.data.hue-rotate; edited(value) => { root.set("hue-rotate", value); } }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Sepia %"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 100; step-size: 5; shown: root.data.sepia; edited(value) => { root.set("sepia", value); } }
            FieldLabel { text: "Invert %"; text-color: root.text-color; min-width: 32px; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 100; step-size: 5; shown: root.data.invert; edited(value) => { root.set("invert", value); } }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Opacity"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 100; step-size: 5; shown: root.data.opacity; edited(value) => { root.set("opacity", value); } }
            FieldLabel { text: "Blend"; text-color: root.text-color; min-width: 32px; }
            ValueCombo {
                horizontal-stretch: 1;
                enabled: root.item-editable;
                model: ["normal", "multiply", "screen", "overlay", "darken", "lighten", "difference", "exclusion", "color-dodge"];
                value: root.data.blend == "" ? "normal" : root.data.blend;
                selected(value) => { root.set("blend", value); }
            }
        }
    }

    SectionHeader { title: "LAYOUT"; text-color: root.text-color; open <=> root.open-layout; }
    if root.open-layout: VerticalLayout {
        spacing: OperatorStyle.space-sm;
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Vertical"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueCombo {
                horizontal-stretch: 1;
                enabled: root.item-editable;
                model: ["top", "center", "bottom"];
                value: root.data.valign;
                selected(value) => { root.set("valign", value); }
            }
            FieldLabel { text: "Turn °"; text-color: root.text-color; min-width: 32px; }
            ValueSpin { horizontal-stretch: 1; enabled: root.item-editable; minimum: 0; maximum: 359; step-size: 15; shown: root.data.rotation; edited(value) => { root.set("rotation", value); } }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Case"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueCombo {
                horizontal-stretch: 1;
                enabled: root.item-editable;
                model: ["none", "uppercase", "lowercase", "capitalize"];
                value: root.data.text-case == "" ? "none" : root.data.text-case;
                selected(value) => { root.set("text-case", value); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    SectionHeader { title: "LAYER ANIMATION"; text-color: root.text-color; open <=> root.open-build; }
    if root.open-build: VerticalLayout {
        spacing: OperatorStyle.space-sm;
        property <bool> has-entrance: root.data.build-enter != "" && root.data.build-enter != "none";
        Text {
            color: root.text-color;
            opacity: 0.75;
            wrap: word-wrap;
            text: root.data.has-item && !root.data.build-allowed
                ? "This layer uses a legacy reveal."
                : "Layers on the same step animate together and share a trigger.";
        }
        if root.build-rows.length > 0: VerticalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Build order"; text-color: root.text-color; }
            ListView {
                min-height: min(root.build-rows.length, 5) * 36px;
                max-height: self.min-height;
                for row in root.build-rows: ListRow {
                    label: row.title;
                    tag: row.trigger;
                    accessible-description: "Layer " + (row.layer + 1) + " · " + row.trigger
                        + (root.selected-layer == row.layer ? " · Selected" : "");
                    active: root.selected-layer == row.layer;
                    accent: root.accent;
                    text-color: root.text-color;
                    accent-text: root.accent-text;
                    clicked => { root.choose-build-layer(row.layer); }
                }
            }
        }
        if self.has-entrance: HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Step"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin {
                accessible-label: "Layer animation step";
                enabled: root.item-editable && root.data.build-allowed;
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 65535;
                shown: root.data.build-step;
                edited(value) => { root.set("build-step", value); }
            }
        }
        if self.has-entrance: HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Start"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueCombo {
                accessible-label: "Animation step trigger";
                horizontal-stretch: 1;
                enabled: root.item-editable && root.data.build-allowed && root.data.build-step > 0;
                model: root.data.build-step == 0 ? ["On Take"] : ["On Click", "After Previous"];
                value: root.data.build-step == 0 ? "On Take" : root.data.build-after-previous ? "After Previous" : "On Click";
                selected(value) => { root.set("build-after-previous", Fmt.flag(value == "After Previous")); }
            }
        }
        for phase[i] in [
            { label: "Entrance", key: "build-enter", effect: root.data.build-enter, duration: root.data.build-enter-duration, delay: root.data.build-enter-delay },
            { label: "Exit", key: "build-exit", effect: root.data.build-exit, duration: root.data.build-exit-duration, delay: root.data.build-exit-delay },
        ]: VerticalLayout {
            spacing: OperatorStyle.space-sm;
            property <bool> on: phase.effect != "" && phase.effect != "none";
            HorizontalLayout {
                spacing: OperatorStyle.space-sm;
                FieldLabel { text: phase.label; text-color: root.text-color; min-width: OperatorStyle.label-width; }
                ValueCombo {
                    accessible-label: phase.label + " effect";
                    enabled: root.item-editable && root.data.build-allowed && (i == 0 || root.data.build-enter != "none");
                    horizontal-stretch: 1;
                    model: i == 0 ? ["None", "Fade", "From left", "From right", "From above", "From below", "Scale in"]
                        : ["None", "Fade", "To left", "To right", "Up", "Down", "Scale out"];
                    value: self.model[max(0, root.choice-index(["none", "fade", "left", "right", "up", "down", "scale"], phase.effect))];
                    selected(_) => {
                        root.set(phase.key, ["none", "fade", "left", "right", "up", "down", "scale"][self.current-index]);
                    }
                }
            }
            if self.on: HorizontalLayout {
                spacing: OperatorStyle.space-sm;
                FieldLabel { text: "Duration (ms)"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
                ValueSpin {
                    accessible-label: phase.label + " duration in milliseconds";
                    enabled: root.item-editable && root.data.build-allowed;
                    horizontal-stretch: 1;
                    minimum: 0;
                    maximum: 10000;
                    step-size: 50;
                    shown: phase.duration;
                    edited(value) => { root.set(phase.key + "-duration", value); }
                }
            }
            if self.on: HorizontalLayout {
                spacing: OperatorStyle.space-sm;
                FieldLabel { text: "Delay (ms)"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
                ValueSpin {
                    accessible-label: phase.label + " delay in milliseconds";
                    enabled: root.item-editable && root.data.build-allowed;
                    horizontal-stretch: 1;
                    minimum: 0;
                    maximum: 60000;
                    step-size: 50;
                    shown: phase.delay;
                    edited(value) => { root.set(phase.key + "-delay", value); }
                }
            }
        }
        Button {
            text: "Preview animations";
            enabled: root.data.build-preview-available;
            clicked => { root.preview-builds(); }
        }
    }

    SectionHeader { title: "TRANSITION"; text-color: root.text-color; open <=> root.open-transition; }
    if root.open-transition: VerticalLayout {
        spacing: OperatorStyle.space-sm;
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Effect"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueCombo {
                accessible-label: "Slide transition effect";
                horizontal-stretch: 1;
                enabled: root.data.has-item;
                model: root.effect-labels;
                value: root.inherited ? root.effect-labels[0]
                    : root.effective-effect >= 0 ? root.effect-labels[root.effective-effect] : root.data.slide-transition;
                selected(_) => { root.set("slide-transition", root.effect-keys[self.current-index]); }
            }
        }
        if root.data.has-item: Text {
            color: root.text-color;
            opacity: 0.8;
            wrap: word-wrap;
            text: root.inherited || root.effective-effect < 0
                ? "\{root.data.slide-transition-source} · \{root.effective-effect >= 0 ? root.effect-labels[root.effective-effect] : root.data.slide-transition}"
                : root.data.slide-transition-source;
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Duration"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueSpin {
                accessible-label: "Transition duration in milliseconds";
                horizontal-stretch: 1;
                enabled: root.data.has-item && root.data.slide-transition != "none";
                minimum: 0;
                maximum: 10000;
                step-size: 100;
                shown: root.data.slide-transition == "none" ? 0 : root.data.slide-transition-ms;
                edited(value) => { root.set("slide-transition-ms", value); }
            }
            FieldLabel { text: "ms"; text-color: root.text-color; min-width: 25px; }
        }
        if root.has-direction: HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Direction"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueCombo {
                accessible-label: "Transition direction";
                horizontal-stretch: 1;
                enabled: root.data.has-item;
                model: root.direction-labels;
                property <int> direction-index: root.choice-index(root.direction-keys, root.data.slide-transition-direction);
                value: self.direction-index >= 0 ? root.direction-labels[self.direction-index] : root.data.slide-transition-direction;
                selected(_) => { root.set("slide-transition-direction", root.direction-keys[self.current-index]); }
            }
        }
        if root.data.slide-transition != "none": HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            FieldLabel { text: "Easing"; text-color: root.text-color; min-width: OperatorStyle.label-width; }
            ValueCombo {
                accessible-label: "Transition easing";
                horizontal-stretch: 1;
                enabled: root.data.has-item;
                model: root.easing-labels;
                property <int> easing-index: root.choice-index(root.easing-keys, root.data.slide-transition-easing);
                value: self.easing-index >= 0 ? root.easing-labels[self.easing-index] : root.data.slide-transition-easing;
                selected(_) => { root.set("slide-transition-easing", root.easing-keys[self.current-index]); }
            }
        }
        HorizontalLayout {
            spacing: OperatorStyle.space-sm;
            Button { text: "Preview transition"; enabled: root.data.has-item; clicked => { root.preview-transition(); } }
            Button {
                text: root.show-transition-range ? "Close range" : "Apply to range…";
                enabled: root.data.has-item && root.transition-slide-count > 1;
                clicked => { root.show-transition-range = !root.show-transition-range; }
            }
        }
        if root.show-transition-range && root.data.has-item && root.transition-slide-count > 1: VerticalLayout {
            spacing: OperatorStyle.space-sm;
            Text {
                color: root.text-color;
                opacity: 0.8;
                wrap: word-wrap;
                text: root.inherited ? "Restore inherited transitions on the chosen slides."
                    : "Copy this slide’s transition to the chosen slides.";
            }
            HorizontalLayout {
                spacing: OperatorStyle.space-sm;
                first-slide := ValueSpin { accessible-label: "First slide in transition range"; minimum: 1; maximum: root.transition-slide-count; shown: 1; }
                FieldLabel { text: "to"; text-color: root.text-color; }
                last-slide := ValueSpin {
                    accessible-label: "Last slide in transition range";
                    minimum: first-slide.value;
                    maximum: root.transition-slide-count;
                    shown: root.transition-slide-count;
                }
                Button {
                    text: root.inherited ? "Reset range" : "Apply range";
                    enabled: first-slide.value >= 1 && last-slide.value >= first-slide.value
                        && last-slide.value <= root.transition-slide-count;
                    clicked => { root.apply-transition-range(first-slide.value, last-slide.value); }
                }
            }
        }
    }
}

export component StageEditorPanel inherits Rectangle {
    in property <string> layout-name;
    in property <string> layout-background;
    in property <string> layout-id;
    in property <[string]> layout-ids;
    in property <[string]> layout-names;
    in property <[StageRowData]> rows;
    in property <[string]> add-kinds;
    // What each add kind is called in the add menu, in the same order.
    in property <[string]> add-names;
    in property <[string]> date-formats;
    // Timer choices: "" follows whichever timer runs, then each named timer's id.
    in property <[string]> timer-ids;
    in property <[string]> timer-names;
    // Variable choices: "" shows nothing, then each variable's id.
    in property <[string]> variable-ids;
    in property <[string]> variable-names;
    in property <[string]> output-ids;
    in property <[string]> output-names;
    in property <[string]> camera-names;
    // Media library pictures/videos for media boxes, and stills for web cards.
    in property <[string]> media-names;
    in property <[string]> media-paths;
    in property <[string]> still-names;
    in property <[string]> still-paths;
    in property <image> preview;
    in property <string> status;
    in-out property <int> selected: 0;
    in property <color> text-color;
    in property <color> accent;
    in property <color> accent-text;
    in property <color> close-fill;
    in property <color> panel: #2a2a32;
    callback set(string, string, string);
    callback select-layout(string);
    callback create-layout(bool);
    callback add(string);
    callback move-item(string, bool);
    callback edit-geometry(string, int, int, bool);
    callback box-at(float, float) -> int;
    callback remove(string);
    callback close();
    property <int> current-index: min(root.selected, root.rows.length - 1);
    property <StageRowData> current: root.rows[root.current-index];
    property <bool> pie-chart: current.chart-kind == "pie" || current.chart-kind == "doughnut" || current.chart-kind == "donut";
    property <string> add-kind: "slide";
    // Typing in a text item saves after a short pause, not on every key.
    text-save := Timer {
        property <string> pending;
        property <string> target;
        property <string> target-layout;
        interval: 600ms;
        running: false;
        triggered => {
            self.save();
        }
        function save() {
            self.running = false;
            if self.target-layout == root.layout-id {
                root.set(self.target, "text", self.pending);
            }
        }
        function queue(value: string) {
            self.pending = value;
            self.target = root.current.id;
            self.target-layout = root.layout-id;
            self.running = false;
            self.running = true;
        }
    }
    VerticalLayout {
        padding: OperatorStyle.panel-pad;
        spacing: OperatorStyle.space-sm;
        PanelHeader {
            title: "Stage editor · " + root.layout-name;
            status: root.status;
            text-color: root.text-color;
            close-fill: root.close-fill;
            close => { if (text-save.running) { text-save.save(); } root.close(); }
        }
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                width: 240px;
                spacing: OperatorStyle.space-sm;
                if root.layout-ids.length > 0: HorizontalLayout {
                    spacing: OperatorStyle.space-sm;
                    FieldLabel { text: "Layout"; text-color: root.text-color; min-width: 0px; }
                    ValueCombo {
                        horizontal-stretch: 1;
                        property <int> layout-index: ComboIndex.find(root.layout-ids, root.layout-id);
                        model: root.layout-names;
                        value: self.layout-index >= 0 ? root.layout-names[self.layout-index] : root.layout-name;
                        selected(value) => {
                            if (text-save.running) { text-save.save(); }
                            root.select-layout(root.layout-ids[self.current-index]);
                            self.follow();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: OperatorStyle.space-sm;
                    BoxButton {
                        label: "New layout";
                        accent: root.accent;
                        text-color: root.text-color;
                        accent-text: root.accent-text;
                        clicked => { if (text-save.running) { text-save.save(); } root.create-layout(false); }
                    }
                    BoxButton {
                        label: "Duplicate layout";
                        accent: root.close-fill;
                        text-color: root.text-color;
                        accent-text: root.text-color;
                        clicked => { if (text-save.running) { text-save.save(); } root.create-layout(true); }
                    }
                }
                HorizontalLayout {
                    spacing: OperatorStyle.space-sm;
                    FieldLabel { text: "Name"; text-color: root.text-color; min-width: 78px; }
                    ValueEdit {
                        horizontal-stretch: 1;
                        shown: root.layout-name;
                        accepted(value) => { root.set("", "layout-name", value); }
                    }
                }
                HorizontalLayout {
                    spacing: OperatorStyle.space-sm;
                    FieldLabel { text: "Background"; text-color: root.text-color; min-width: 78px; }
                    ColorField {
                        hex: root.layout-background;
                        text-color: root.text-color;
                        panel: root.panel;
                        set(value) => { root.set("", "layout-background", value); }
                    }
                }
                HorizontalLayout {
                    spacing: OperatorStyle.space-sm;
                    ValueCombo {
                        horizontal-stretch: 1;
                        model: root.add-names;
                        value: root.add-names[max(0, ComboIndex.find(root.add-kinds, root.add-kind))];
                        selected(value) => { root.add-kind = root.add-kinds[self.current-index]; }
                    }
                    BoxButton {
                        label: "Add item";
                        accent: root.accent;
                        text-color: root.text-color;
                        accent-text: root.accent-text;
                        clicked => { root.add(root.add-kind); }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        for row[index] in root.rows: ListRow {
                            label: row.enabled ? row.title : row.title + " (hidden)";
                            active: index == root.selected;
                            accent: root.accent;
                            text-color: root.text-color;
                            accent-text: root.accent-text;
                            clicked => { if (text-save.running) { text-save.save(); } root.selected = index; }
                        }
                    }
                }
            }
            if root.rows.length > 0: VerticalLayout {
                horizontal-stretch: 1;
                spacing: OperatorStyle.space-sm;
                ScrollView {
                    vertical-stretch: 1;
                    GridLayout {
                    spacing: OperatorStyle.space-sm;
                    Row {
                        FieldLabel { text: "Box label"; text-color: root.text-color; }
                        ValueEdit {
                            colspan: 3;
                            property <string> item-source: root.current.id;
                            property <string> layout-source: root.layout-id;
                            changed item-source => { self.text = self.shown; }
                            changed layout-source => { self.text = self.shown; }
                            shown: root.current.label;
                            placeholder-text: "Default name";
                            accepted(value) => { root.set(root.current.id, "label", value); }
                        }
                    }
                    Row {
                        ValueSwitch {
                            colspan: 4;
                            text: "Show on stage";
                            shown: root.current.enabled;
                            toggled => { root.set(root.current.id, "enabled", Fmt.flag(self.checked)); }
                        }
                    }
                    Row {
                        FieldLabel { text: "Left"; text-color: root.text-color; }
                        ValueSpin { minimum: -8000; maximum: 8000; shown: root.current.x; edited(value) => { root.set(root.current.id, "left", value); } }
                        FieldLabel { text: "Top"; text-color: root.text-color; }
                        ValueSpin { minimum: -8000; maximum: 8000; shown: root.current.y; edited(value) => { root.set(root.current.id, "top", value); } }
                    }
                    Row {
                        FieldLabel { text: "Width"; text-color: root.text-color; }
                        ValueSpin { minimum: 1; maximum: 8000; shown: root.current.w; edited(value) => { root.set(root.current.id, "width", value); } }
                        FieldLabel { text: "Height"; text-color: root.text-color; }
                        ValueSpin { minimum: 1; maximum: 8000; shown: root.current.h; edited(value) => { root.set(root.current.id, "height", value); } }
                    }
                    Row {
                        FieldLabel { text: "Font size"; text-color: root.text-color; }
                        ValueSpin { minimum: 8; maximum: 800; shown: root.current.font-px; edited(value) => { root.set(root.current.id, "font-size", value); } }
                        FieldLabel { text: "Color"; text-color: root.text-color; }
                        ColorField {
                            hex: root.current.color;
                            text-color: root.text-color;
                            panel: root.panel;
                            placeholder: "#FFFFFF";
                            set(value) => { root.set(root.current.id, "color", value); }
                        }
                    }
                    if root.current.kind == "slide" || root.current.kind == "notes" || root.current.kind == "text" || root.current.kind == "clock" || root.current.kind == "timer" || root.current.kind == "tracker": Row {
                        FieldLabel { text: "Align"; text-color: root.text-color; }
                        ValueCombo {
                            model: ["left", "center", "right"];
                            value: root.current.align;
                            selected(value) => { root.set(root.current.id, "align", value); }
                        }
                    }
                    if root.current.kind == "slide" || root.current.kind == "notes": Row {
                        FieldLabel { text: "Slide offset (0 = current)"; text-color: root.text-color; }
                        ValueSpin {
                            minimum: -99;
                            maximum: 99;
                            shown: root.current.offset;
                            edited(value) => { root.set(root.current.id, "offset", value); }
                        }
                    }
                    if root.current.kind == "slide": Row {
                        FieldLabel { text: "Max lines (0 for all)"; text-color: root.text-color; }
                        ValueSpin {
                            minimum: 0;
                            maximum: 99;
                            shown: root.current.line-count;
                            edited(value) => { root.set(root.current.id, "line-count", value); }
                        }
                    }
                    if root.current.kind == "slide": Row {
                        FieldLabel { text: "Text box (0 for all)"; text-color: root.text-color; }
                        ValueSpin {
                            minimum: 0;
                            maximum: 99;
                            shown: root.current.text-box;
                            edited(value) => { root.set(root.current.id, "text-box", value); }
                        }
                        ValueSwitch {
                            text: "Reverse box order";
                            shown: root.current.invert-items;
                            toggled => { root.set(root.current.id, "invert-items", self.checked ? "true" : "false"); }
                        }
                    }
                    if root.current.kind == "slide": Row {
                        ValueSwitch {
                            colspan: 2;
                            text: "Include slide background";
                            shown: root.current.include-media;
                            toggled => { root.set(root.current.id, "include-media", self.checked ? "true" : "false"); }
                        }
                    }
                    if root.current.kind == "clock": Row {
                        FieldLabel { text: "Seconds"; text-color: root.text-color; }
                        ValueSwitch {
                            text: "Show seconds";
                            shown: root.current.seconds;
                            toggled => { root.set(root.current.id, "seconds", self.checked ? "true" : "false"); }
                        }
                        FieldLabel { text: "Date"; text-color: root.text-color; }
                        ValueCombo {
                            model: root.date-formats;
                            value: root.current.date-format;
                            selected(value) => { root.set(root.current.id, "date-format", value); }
                        }
                    }
                    if root.current.kind == "timer": Row {
                        FieldLabel { text: "Timer"; text-color: root.text-color; }
                        ValueCombo {
                            colspan: 3;
                            model: root.timer-names;
                            value: root.timer-names[max(0, ComboIndex.find(root.timer-ids, root.current.timer))];
                            selected(value) => { root.set(root.current.id, "timer", root.timer-ids[self.current-index]); }
                        }
                    }
                    if root.current.kind == "variable": Row {
                        FieldLabel { text: "Variable"; text-color: root.text-color; }
                        ValueCombo {
                            colspan: 3;
                            model: root.variable-names;
                            value: root.variable-names[max(0, ComboIndex.find(root.variable-ids, root.current.variable))];
                            selected(value) => { root.set(root.current.id, "variable", root.variable-ids[self.current-index]); }
                        }
                    }
                    if root.current.kind == "media": Row {
                        FieldLabel { text: "File"; text-color: root.text-color; }
                        ValueEdit {
                            colspan: 3;
                            placeholder-text: "Picture or video path, then Enter";
                            shown: root.current.src;
                            accepted(value) => { root.set(root.current.id, "src", value); }
                        }
                    }
                    if root.current.kind == "media" && root.media-names.length > 0: Row {
                        FieldLabel { text: "Library"; text-color: root.text-color; }
                        media-pick := ValueCombo {
                            colspan: 2;
                            model: root.media-names;
                            value: root.media-names[0];
                        }
                        BoxButton {
                            label: "Use";
                            accent: root.accent;
                            text-color: root.text-color;
                            accent-text: root.accent-text;
                            clicked => {
                                if (media-pick.current-index >= 0 && media-pick.current-index < root.media-paths.length) {
                                    root.set(root.current.id, "src", root.media-paths[media-pick.current-index]);
                                }
                            }
                        }
                    }
                    if root.current.kind == "camera": Row {
                        FieldLabel { text: "Camera"; text-color: root.text-color; }
                        ValueCombo {
                            colspan: 3;
                            model: root.camera-names;
                            value: root.current.device-name == "" ? "No camera selected" : root.current.device-name;
                            selected(value) => { root.set(root.current.id, "camera-device", self.current-index == 0 ? "" : value); }
                        }
                    }
                    if root.current.kind == "camera" || root.current.kind == "media": Row {
                        FieldLabel { text: "Fit"; text-color: root.text-color; }
                        ValueCombo {
                            model: ["contain", "cover", "fill"];
                            value: root.current.fit;
                            selected(value) => { root.set(root.current.id, "fit", value); }
                        }
                    }
                    if root.current.kind == "camera": Row {
                        ValueSwitch {
                            colspan: 2;
                            text: "Flip horizontally";
                            shown: root.current.flip-x;
                            toggled => { root.set(root.current.id, "flip-x", Fmt.flag(self.checked)); }
                        }
                        ValueSwitch {
                            colspan: 2;
                            text: "Flip vertically";
                            shown: root.current.flip-y;
                            toggled => { root.set(root.current.id, "flip-y", Fmt.flag(self.checked)); }
                        }
                    }
                    if root.current.kind == "tracker": Row {
                        FieldLabel { text: "Look"; text-color: root.text-color; }
                        ValueCombo {
                            model: ["Slide number", "Progress bar"];
                            value: root.current.tracker-type == "bar" ? "Progress bar" : "Slide number";
                            selected(value) => { root.set(root.current.id, "tracker-type", self.current-index == 1 ? "bar" : "number"); }
                        }
                        FieldLabel { text: "Bar color"; text-color: root.text-color; }
                        ColorField {
                            hex: root.current.tracker-accent;
                            text-color: root.text-color;
                            panel: root.panel;
                            placeholder: "Theme accent";
                            set(value) => { root.set(root.current.id, "tracker-accent", value); }
                        }
                    }
                    if root.current.kind == "qr": Row {
                        FieldLabel { text: "QR content"; text-color: root.text-color; }
                        ValueEdit {
                            colspan: 3;
                            shown: root.current.qr-text;
                            accepted(value) => { root.set(root.current.id, "qr-text", value); }
                        }
                    }
                    if root.current.kind == "qr": Row {
                        FieldLabel { text: "Code color"; text-color: root.text-color; }
                        ColorField {
                            hex: root.current.qr-color;
                            text-color: root.text-color;
                            panel: root.panel;
                            set(value) => { root.set(root.current.id, "qr-color", value); }
                        }
                        FieldLabel { text: "Background"; text-color: root.text-color; }
                        ColorField {
                            hex: root.current.qr-background;
                            text-color: root.text-color;
                            panel: root.panel;
                            allow-none: true;
                            placeholder: "Transparent";
                            set(value) => { root.set(root.current.id, "qr-background", value); }
                        }
                    }
                    if root.current.kind == "output": Row {
                        FieldLabel { text: "Preview source"; text-color: root.text-color; }
                        ValueCombo {
                            colspan: 3;
                            property <int> source-index: ComboIndex.find(root.output-ids, root.current.output-source);
                            model: root.output-names;
                            value: self.source-index >= 0 ? root.output-names[self.source-index] : "Missing output (" + root.current.output-source + ")";
                            selected(value) => { root.set(root.current.id, "output-source", root.output-ids[self.current-index]); }
                        }
                    }
                    if root.current.kind == "output": Row {
                        ValueSwitch {
                            colspan: 4;
                            text: "Show output name";
                            shown: root.current.show-output-label;
                            toggled => { root.set(root.current.id, "show-output-label", Fmt.flag(self.checked)); }
                        }
                    }
                    if root.current.kind == "web": Row {
                        FieldLabel { text: "Page address"; text-color: root.text-color; }
                        ValueEdit {
                            colspan: 3;
                            shown: root.current.web-url;
                            accepted(value) => { root.set(root.current.id, "web-url", value); }
                        }
                    }
                    if root.current.kind == "web": Row {
                        FieldLabel { text: "Still image"; text-color: root.text-color; }
                        ValueEdit {
                            colspan: 3;
                            placeholder-text: "Optional file path";
                            shown: root.current.src;
                            accepted(value) => { root.set(root.current.id, "src", value); }
                        }
                    }
                    if root.current.kind == "web" && root.still-names.length > 0: Row {
                        FieldLabel { text: "Library"; text-color: root.text-color; }
                        still-pick := ValueCombo {
                            colspan: 2;
                            model: root.still-names;
                            value: root.still-names[0];
                        }
                        BoxButton {
                            label: "Use";
                            accent: root.accent;
                            text-color: root.text-color;
                            accent-text: root.accent-text;
                            clicked => {
                                if (still-pick.current-index >= 0 && still-pick.current-index < root.still-paths.length) {
                                    root.set(root.current.id, "src", root.still-paths[still-pick.current-index]);
                                }
                            }
                        }
                    }
                    if root.current.kind == "chart": Row {
                        FieldLabel { text: "Chart type"; text-color: root.text-color; }
                        ValueCombo {
                            model: ["Bar", "Line", "Pie"];
                            value: root.current.chart-kind == "line" ? "Line" : root.pie-chart ? "Pie" : "Bar";
                            selected(value) => { root.set(root.current.id, "chart-kind", self.current-index == 1 ? "line" : self.current-index == 2 ? "pie" : "bar"); }
                        }
                        FieldLabel { text: "Pie hole (%)"; text-color: root.text-color; }
                        ValueSpin {
                            enabled: root.pie-chart;
                            minimum: 0;
                            maximum: 90;
                            shown: min(root.current.chart-hole-size, 90);
                            edited(value) => { root.set(root.current.id, "chart-hole-size", value); }
                        }
                    }
                    if root.current.kind == "chart": Row {
                        VerticalLayout {
                            colspan: 4;
                            spacing: 4px;
                            FieldLabel { text: "Chart data (one label: value per line)"; text-color: root.text-color; }
                            chart-data := TextEdit {
                                property <string> item-id: root.current.id;
                                property <string> source-layout: root.layout-id;
                                changed item-id => { self.text = root.current.chart-data; }
                                changed source-layout => { self.text = root.current.chart-data; }
                                height: 90px;
                                text: root.current.chart-data;
                            }
                            HorizontalLayout {
                                alignment: end;
                                BoxButton {
                                    label: "Apply chart data";
                                    accent: root.accent;
                                    text-color: root.text-color;
                                    accent-text: root.accent-text;
                                    clicked => { root.set(root.current.id, "chart-data", chart-data.text); }
                                }
                            }
                        }
                    }
                    if root.current.kind == "text": Row {
                        FieldLabel { text: "Text"; text-color: root.text-color; }
                        TextEdit {
                            // Picking another text item loads its words even after typing here.
                            property <string> source: root.current.id;
                            property <string> source-layout: root.layout-id;
                            changed source => { self.text = root.current.text; }
                            changed source-layout => { self.text = root.current.text; }
                            colspan: 3;
                            height: 90px;
                            text: root.current.text;
                            edited(value) => { text-save.queue(value); }
                        }
                    }
                    Row {
                        HorizontalLayout {
                            colspan: 3;
                            spacing: OperatorStyle.space-sm;
                            Button {
                                text: "Move backward";
                                enabled: root.current-index > 0;
                                clicked => { if (text-save.running) { text-save.save(); } root.move-item(root.current.id, false); }
                            }
                            Button {
                                text: "Move forward";
                                enabled: root.current-index < root.rows.length - 1;
                                clicked => { if (text-save.running) { text-save.save(); } root.move-item(root.current.id, true); }
                            }
                        }
                        BoxButton {
                            col: 3;
                            label: "Remove item";
                            accent: root.close-fill;
                            text-color: root.text-color;
                            accent-text: root.text-color;
                            clicked => { root.remove(root.current.id); }
                        }
                    }
                }
                }
                // The whole layout as the stage screen shows it, with the picked item outlined.
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 120px;
                    preview-box := Rectangle {
                        property <float> aspect: root.preview.width > 0 && root.preview.height > 0
                            ? root.preview.width / root.preview.height : 1920.0 / 1080.0;
                        property <length> unit-x: self.width / 1920;
                        property <length> unit-y: self.height / 1080;
                        width: min(parent.width, parent.height * self.aspect);
                        height: self.width / self.aspect;
                        x: (parent.width - self.width) / 2;
                        y: 0;
                        background: black;
                        clip: true;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.preview;
                            image-fit: contain;
                        }
                        Rectangle {
                            x: drag.preview-x * preview-box.unit-x;
                            y: drag.preview-y * preview-box.unit-y;
                            width: drag.preview-width * preview-box.unit-x;
                            height: drag.preview-height * preview-box.unit-y;
                            border-width: 2px;
                            border-color: root.accent;
                            Rectangle {
                                width: drag.handle-size;
                                height: self.width;
                                x: parent.width - self.width;
                                y: parent.height - self.height;
                                background: root.accent;
                            }
                        }
                        drag := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            property <length> box-x: root.current.x * preview-box.unit-x;
                            property <length> box-y: root.current.y * preview-box.unit-y;
                            property <length> box-width: root.current.w * preview-box.unit-x;
                            property <length> box-height: root.current.h * preview-box.unit-y;
                            property <length> right: self.box-x + self.box-width;
                            property <length> bottom: self.box-y + self.box-height;
                            property <string> source;
                            property <string> source-layout;
                            property <bool> resizing;
                            property <length> handle-size: min(10px, min(self.box-width, self.box-height) * 0.45);
                            property <bool> over-box: self.mouse-x >= self.box-x && self.mouse-x < self.right && self.mouse-y >= self.box-y && self.mouse-y < self.bottom;
                            property <bool> over-handle: self.over-box && self.mouse-x >= self.right - self.handle-size && self.mouse-y >= self.bottom - self.handle-size;
                            property <bool> same-box: self.source != "" && self.source == root.current.id && self.source-layout == root.layout-id;
                            property <length> dx: self.mouse-x - self.pressed-x;
                            property <length> dy: self.mouse-y - self.pressed-y;
                            property <bool> moved-far: abs(self.dx) > 3px || abs(self.dy) > 3px;
                            property <int> stage-dx: round(self.dx / max(0.001px, preview-box.unit-x));
                            property <int> stage-dy: round(self.dy / max(0.001px, preview-box.unit-y));
                            property <int> drop-x: clamp(root.current.x + self.stage-dx, -8000, 8000);
                            property <int> drop-y: clamp(root.current.y + self.stage-dy, -8000, 8000);
                            property <int> drop-width: clamp(root.current.w + self.stage-dx, 1, 8000);
                            property <int> drop-height: clamp(root.current.h + self.stage-dy, 1, 8000);
                            property <bool> preview-drag: self.pressed && self.same-box && self.moved-far;
                            property <int> preview-x: self.preview-drag && !self.resizing ? self.drop-x : root.current.x;
                            property <int> preview-y: self.preview-drag && !self.resizing ? self.drop-y : root.current.y;
                            property <int> preview-width: self.preview-drag && self.resizing ? self.drop-width : root.current.w;
                            property <int> preview-height: self.preview-drag && self.resizing ? self.drop-height : root.current.h;
                            mouse-cursor: (self.pressed ? self.resizing : self.over-handle) ? MouseCursor.se-resize : self.pressed && self.same-box ? MouseCursor.grabbing : self.over-box ? MouseCursor.grab : MouseCursor.default;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    self.source = "";
                                    self.resizing = self.over-handle;
                                    if (!self.resizing) {
                                        self.select-hit(root.box-at(
                                            self.mouse-x / max(0.001px, preview-box.unit-x),
                                            self.mouse-y / max(0.001px, preview-box.unit-y)
                                        ));
                                    }
                                    if (self.over-box) {
                                        self.source = root.current.id;
                                    }
                                    self.source-layout = root.layout-id;
                                } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && self.same-box && self.moved-far) {
                                    if (self.resizing) {
                                        root.edit-geometry(self.source, self.drop-width, self.drop-height, true);
                                    } else {
                                        root.edit-geometry(self.source, self.drop-x, self.drop-y, false);
                                    }
                                }
                            }
                            function select-hit(index: int) {
                                if (index >= 0 && index != root.selected) {
                                    if (text-save.running) { text-save.save(); }
                                    root.selected = index;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
