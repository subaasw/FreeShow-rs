// Shared operator chrome: style tokens and buttons.

export global OperatorStyle {
    in-out property <float> font-scale: 1;
    in-out property <color> hover: rgba(255, 255, 255, 0.05);
    in-out property <color> focus-fill: rgba(255, 255, 255, 0.1);
    // 8px grid chrome: header / rail / fields / swatches share these.
    in-out property <length> chrome-radius: 6px;
    in-out property <length> space-xs: 4px;
    in-out property <length> space-sm: 8px;
    in-out property <length> space: 12px;
    in-out property <length> space-lg: 16px;
    in-out property <length> header-height: 48px;
    in-out property <length> rail-width: 80px;
    in-out property <length> rail-btn: 56px;
    in-out property <length> status-height: 28px;
    in-out property <length> field-height: 32px;
    in-out property <length> swatch-size: 28px;
    in-out property <length> label-width: 56px;
    in-out property <length> panel-pad: 12px;
}

component ActivationKeyScope inherits FocusScope {
    callback activated();
    key-pressed(event) => {
        if ((event.text == Key.Space || event.text == Key.Return) && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !event.modifiers.shift) {
            return accept;
        }
        return reject;
    }
    key-released(event) => {
        if ((event.text == Key.Space || event.text == Key.Return) && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !event.modifiers.shift) {
            root.activated();
            return accept;
        }
        return reject;
    }
}

export component RailButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <color> primary;
    in property <color> accent;
    in property <color> text-color;
    in property <color> accent-text;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    border-color: root.text-color;
    border-width: key-focus.has-focus ? 1px : 0px;
    min-height: OperatorStyle.rail-btn;
    preferred-height: OperatorStyle.rail-btn;
    max-height: OperatorStyle.rail-btn;
    border-radius: OperatorStyle.chrome-radius;
    background: root.active ? root.accent : root.primary;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: parent.border-radius;
        background: root.active ? transparent : pointer.has-hover ? OperatorStyle.hover : (key-focus.has-focus ? OperatorStyle.focus-fill : transparent);
    }
    Text {
        text: root.label;
        color: root.active ? root.accent-text : root.text-color;
        font-size: 12px * OperatorStyle.font-scale;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        width: parent.width - 8px;
    }
    key-focus := ActivationKeyScope {
        width: 100%;
        height: 100%;
        activated => { root.clicked(); }
    }
    pointer := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }
}

export component BoxButton inherits Rectangle {
    in property <string> label;
    in property <color> accent;
    in property <color> text-color;
    in property <color> accent-text;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    border-color: root.text-color;
    border-width: key-focus.has-focus ? 1px : 0px;
    horizontal-stretch: 1;
    height: OperatorStyle.field-height;
    border-radius: OperatorStyle.chrome-radius;
    background: root.accent;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: parent.border-radius;
        background: pointer.has-hover ? OperatorStyle.hover : (key-focus.has-focus ? OperatorStyle.focus-fill : transparent);
    }
    Text {
        text: root.label;
        color: root.accent-text;
        font-size: 12px * OperatorStyle.font-scale;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    key-focus := ActivationKeyScope {
        width: 100%;
        height: 100%;
        activated => { root.clicked(); }
    }
    pointer := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }
}

export component HeaderButton inherits Rectangle {
    in property <string> label;
    in property <color> accent;
    in property <color> text-color;
    in property <color> accent-text;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    border-color: root.text-color;
    border-width: key-focus.has-focus ? 1px : 0px;
    min-width: max(56px, label-text.preferred-width + 12px);
    preferred-width: max(88px, label-text.preferred-width + 20px);
    max-width: max(88px, label-text.preferred-width + 20px);
    height: OperatorStyle.field-height;
    border-radius: OperatorStyle.chrome-radius;
    background: root.accent;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: parent.border-radius;
        background: pointer.has-hover ? OperatorStyle.hover : (key-focus.has-focus ? OperatorStyle.focus-fill : transparent);
    }
    label-text := Text {
        text: root.label;
        color: root.accent-text;
        font-size: 13px * OperatorStyle.font-scale;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    key-focus := ActivationKeyScope {
        width: 100%;
        height: 100%;
        activated => { root.clicked(); }
    }
    pointer := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }
}

export component ListRow inherits Rectangle {
    in property <string> label;
    // A short dim note at the right edge, such as a project row's media kind.
    in property <string> tag;
    in property <bool> active;
    in property <image> thumb;
    in property <bool> show-thumb;
    // On air: an overlay that is showing or the audio that is playing.
    in property <bool> on: false;
    in property <color> accent;
    in property <color> text-color;
    in property <color> accent-text;
    in property <bool> has-color: false;
    in property <bool> full-color: false;
    in property <color> group-color: #00000000;
    in property <color> group-text: #f0f0ff;
    // Rows that can be dragged up or down report how far, then where they were let go.
    in property <bool> draggable: false;
    out property <bool> dragging: false;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    border-color: root.text-color;
    border-width: key-focus.has-focus ? 1px : 0px;
    callback drag-moved(length);
    callback dropped(length);
    height: root.show-thumb ? 48px : 36px;
    border-radius: OperatorStyle.chrome-radius;
    background: root.active ? root.accent : (root.full-color && root.has-color ? root.group-color : (pointer.has-hover ? OperatorStyle.hover : (key-focus.has-focus ? OperatorStyle.focus-fill : transparent)));
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        if root.show-thumb: Image {
            source: root.thumb;
            width: 56px;
            height: 40px;
            image-fit: contain;
        }
        Text {
            text: root.label;
            color: root.active ? root.accent-text : (root.has-color ? root.group-text : root.text-color);
            font-size: 13px * OperatorStyle.font-scale;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.tag != "": Text {
            text: root.tag;
            color: root.active ? root.accent-text : root.text-color;
            opacity: 0.6;
            font-size: 11px * OperatorStyle.font-scale;
            vertical-alignment: center;
        }
    }
    if root.on && !root.active: Rectangle {
        x: 0;
        width: 4px;
        height: 100%;
        background: root.accent;
    }
    if root.has-color && !root.full-color && !root.active: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: 100%;
        background: root.group-color;
    }
    key-focus := ActivationKeyScope {
        width: 100%;
        height: 100%;
        activated => { root.clicked(); }
    }
    pointer := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.default;
        clicked => {
            if (!root.dragging) {
                key-focus.focus();
                root.clicked();
            }
        }
        moved => {
            if (root.draggable && self.pressed) {
                if (abs(self.mouse-y - self.pressed-y) > 8px) {
                    root.dragging = true;
                }
                if (root.dragging) {
                    root.drag-moved(self.mouse-y - self.pressed-y);
                }
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dragging = false;
            } else if (event.kind == PointerEventKind.up && root.dragging) {
                root.dropped(self.mouse-y - self.pressed-y);
            }
        }
    }
}

// Maps key presses to shortcut chords for the operator, output and stage windows.
export component HotkeyScope inherits FocusScope {
    callback hotkey(string, bool, bool, bool);
    key-pressed(event) => {
            if ((event.text == Key.Tab || event.text == Key.Backtab) && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                return reject;
            }
            if (event.text == Key.F11) {
                root.hotkey("F11", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            } else if (event.text == Key.F1) {
                root.hotkey("F1", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            } else if (event.text == Key.F2) {
                root.hotkey("F2", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            } else if (event.text == Key.F3) {
                root.hotkey("F3", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            } else if (event.text == Key.F4) {
                root.hotkey("F4", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            } else if (event.text == Key.F5) {
                root.hotkey("F5", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            } else if (event.text == Key.RightArrow) {
                root.hotkey("Right", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            } else if (event.text == Key.LeftArrow) {
                root.hotkey("Left", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            } else if (event.text == Key.PageDown) {
                root.hotkey("PageDown", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            } else if (event.text == Key.PageUp) {
                root.hotkey("PageUp", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            } else if (event.text == Key.Escape) {
                root.hotkey("Escape", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            } else {
                root.hotkey(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            }
            accept
        }
}

// One slide in the show's slide list: a thumbnail when there is one, else its text.
export component SlideCard inherits Rectangle {
    in property <string> label;
    in property <int> number;
    in property <image> thumb;
    in property <bool> has-thumb;
    in property <bool> active;
    in property <bool> live;
    in property <color> accent;
    in property <color> text-color;
    in property <color> accent-text;
    in property <bool> has-color: false;
    in property <bool> full-color: false;
    in property <color> group-color: #00000000;
    in property <color> group-text: #f0f0ff;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.live ? "Live" : root.active ? "Selected" : "";
    accessible-action-default => { root.clicked(); }
    border-radius: OperatorStyle.chrome-radius;
    background: root.live ? root.accent : (root.active ? (root.has-thumb ? #ffffffb0 : #ffffff28) : (pointer.has-hover ? OperatorStyle.hover : #00000030));
    border-width: key-focus.has-focus || (root.active && !root.live && !root.has-thumb) ? 1px : 0px;
    border-color: key-focus.has-focus ? root.text-color : root.accent;
    if root.has-thumb: Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: (parent.width - 6px) * 9 / 16;
        background: black;
        Image {
            source: root.thumb;
            width: 100%;
            height: 100%;
            image-fit: contain;
        }
        if root.live: Rectangle {
            x: 4px;
            y: 4px;
            width: live-tag.preferred-width + 10px;
            height: 16px;
            border-radius: 3px;
            background: #c0392b;
            live-tag := Text {
                text: "LIVE";
                color: #ffffff;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    Rectangle {
        x: 3px;
        y: root.has-thumb ? parent.height - 25px : 3px;
        width: parent.width - 6px;
        height: root.has-thumb ? 22px : parent.height - 6px;
        border-radius: OperatorStyle.chrome-radius;
        background: root.has-color ? (root.full-color ? root.group-color : #00000060) : #00000060;
        if root.has-color && !root.full-color: Rectangle {
            x: 0;
            width: 4px;
            height: 100%;
            background: root.group-color;
        }
        Text {
            x: 10px;
            width: parent.width - (root.live && !root.has-thumb ? 56px : 14px);
            text: root.number > 0 ? root.number + "  " + root.label : root.label;
            color: root.live && !root.has-thumb ? root.accent-text : (root.has-color ? root.group-text : root.text-color);
            font-size: 12px * OperatorStyle.font-scale;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.live && !root.has-thumb: Rectangle {
        x: parent.width - 46px;
        y: (parent.height - 16px) / 2;
        width: 38px;
        height: 16px;
        border-radius: 3px;
        background: #c0392b;
        Text {
            text: "LIVE";
            color: #ffffff;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    key-focus := ActivationKeyScope {
        width: 100%;
        height: 100%;
        activated => { root.clicked(); }
    }
    pointer := TouchArea {
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }
}
