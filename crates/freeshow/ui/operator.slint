// SPDX-License-Identifier: GPL-3.0-only
// Operator, output and stage windows. Compiled by build.rs (slint-build).

import { ComboBox, LineEdit, Palette, ScrollView, Slider, TextEdit } from "std-widgets.slint";
import { OperatorStyle, RailButton, BoxButton, HeaderButton, ListRow, HotkeyScope, SlideCard } from "widgets.slint";
import { SettingsPanel, SettingsData, InspectorPanel, InspectorData, StageEditorPanel, StageRowData } from "panels.slint";

export { OperatorStyle, SettingsData, InspectorData, StageRowData }

struct DrawerTab { id: string, label: string, short: string }

export struct DrawerRowData {
    name: string,
    thumb: image,
    show-thumb: bool,
    on: bool,
}

export struct SlideRowData {
    label: string,
    index: int,
    thumb: image,
    has-thumb: bool,
    has-color: bool,
    group-color: color,
    group-text: color,
}

export component ControlWindow inherits Window {
    title: "FreeShow";
    in property <string> theme-font-family;
    // Std widgets follow the FreeShow theme: dark palettes get dark inputs.
    in property <bool> dark-chrome: true;
    init => { Palette.color-scheme = root.dark-chrome ? ColorScheme.dark : ColorScheme.light; }
    changed dark-chrome => { Palette.color-scheme = root.dark-chrome ? ColorScheme.dark : ColorScheme.light; }
    default-font-family: root.theme-font-family;
    default-font-size: 14px * OperatorStyle.font-scale;
    in property <color> primary: #242832;
    in property <color> primary-lighter: #2f3542;
    in property <color> primary-darker: #191923;
    in property <color> primary-darkest: #12121c;
    in property <color> text-color: #f0f0ff;
    in property <color> accent: #F0008C;
    in property <color> accent-text: #f0f0ff;
    in-out property <string> active-tab: "shows";
    in-out property <string> panel-title: "Shows";
    in property <string> data-path: "Data folder not set";
    in-out property <[DrawerRowData]> drawer-rows;
    in-out property <[SlideRowData]> slide-cards;
    in-out property <int> slides-columns: 1;
    in-out property <bool> full-colors: false;
    in-out property <[string]> project-names;
    in-out property <string> project-title: "Project";
    in-out property <string> lyrics: "";
    in-out property <string> group: "";
    in-out property <float> volume: 100;
    in-out property <int> selected-drawer: -1;
    in-out property <int> selected-slide: -1;
    in property <int> live-slide: -1;
    in property <string> now-playing;
    in property <string> now-playing-time;
    in property <float> now-playing-progress;
    in property <bool> now-playing-paused;
    in-out property <int> selected-project: -1;
    in-out property <image> preview;
    in-out property <image> edit-preview;
    callback edit-mode-changed();
    changed edit-mode => { root.edit-mode-changed(); }
    in property <string> import-status;
    in-out property <string> chrome-status: "";
    in property <bool> import-running;
    callback cancel-import();
    callback open-output();
    callback open-stage();
    callback choose-screen();
    in-out property <string> screen-label: "Screen";
    in-out property <bool> output-open: false;
    in-out property <bool> stage-open: false;
    in-out property <string> search-query: "";
    in-out property <int> drawer-width: 240;
    in-out property <int> project-width: 260;
    in-out property <int> drawer-height: 300;
    in-out property <bool> focus-mode: false;
    in-out property <bool> guide-visible: false;
    in-out property <string> guide-text: "";
    in-out property <bool> show-shortcuts: false;
    in-out property <string> shortcut-text: "";
    in property <bool> show-labels: true;
    callback dismiss-guide();
    in-out property <bool> show-settings: false;
    in property <SettingsData> settings-data;
    in property <[string]> theme-names;
    in property <[string]> autosave-choices;
    in property <string> settings-status;
    callback apply-setting(string, string);
    in property <string> update-label: "";
    callback get-update();
    in-out property <string> spelling: "";
    callback lyrics-edited(string);
    in property <InspectorData> inspector-data;
    callback inspector-set(string, string);
    in-out property <bool> show-stage-editor: false;
    in property <string> stage-layout-name;
    in property <[StageRowData]> stage-rows;
    in property <[string]> stage-add-kinds;
    in property <string> stage-status;
    in-out property <int> stage-selected: 0;
    callback stage-set(string, string, string);
    callback stage-add(string);
    callback stage-remove(string);
    callback save-shortcuts(string);
    callback save-layouts(string);
    callback save-variables(string);
    in-out property <bool> show-layouts: false;
    in-out property <string> layout-text: "";
    in-out property <bool> show-variables: false;
    in-out property <string> variable-text: "";
    callback save-timeline(string);
    callback play-timeline();
    in-out property <bool> show-timeline: false;
    in-out property <string> timeline-text: "";
    callback hotkey(string, bool, bool, bool);
    callback set-search(string);
    callback select-tab(string);
    callback choose-drawer(int);
    callback choose-slide(int);
    callback save-lyrics(string);
    callback save-group(string);
    in-out property <string> item-label: "Box 1 of 1";
    callback prev-item();
    callback next-item();
    callback add-item();
    callback remove-item();
    callback go-slide(string);
    callback move-project(int);
    callback choose-project(int);
    callback add-to-project();
    callback create-show();
    callback add-slide();
    // One callback for library edits: rename/duplicate/delete shows, slide order, projects.
    callback library-action(string, string);
    callback show-text-edited(string);
    in property <string> show-name;
    in-out property <string> show-text;
    in-out property <bool> text-mode: false;
    // Edit mode: clicking a slide only selects it for editing. Otherwise a click presents it.
    in-out property <bool> edit-mode: false;
    property <bool> editing: root.active-tab == "shows" && root.show-name != "" && root.edit-mode;
    callback clear-output(string);
    callback audio-control(string);
    out property <bool> text-focused: show-editor.has-focus;
    in property <string> notice;
    in property <bool> can-restore;
    in property <[string]> project-choices;
    in property <int> project-choice;
    property <bool> confirm-show-delete: false;
    property <bool> confirm-project-delete: false;
    callback create-project();
    callback search(string);
    callback set-volume(float);

    preferred-width: 1280px;
    preferred-height: 800px;
    background: root.primary-darkest;

    in-out property <[DrawerTab]> tabs: [
        { id: "shows", label: "Shows", short: "S" },
        { id: "media", label: "Media", short: "M" },
        { id: "player", label: "Player", short: "P" },
        { id: "audio", label: "Audio", short: "A" },
        { id: "overlays", label: "Overlays", short: "O" },
        { id: "templates", label: "Templates", short: "T" },
        { id: "scripture", label: "Scripture", short: "B" },
        { id: "calendar", label: "Calendar", short: "C" },
        { id: "rss", label: "RSS", short: "R" },
        { id: "functions", label: "Functions", short: "F" },
    ];

    Timer {
        interval: 3s;
        running: root.confirm-show-delete || root.confirm-project-delete;
        triggered => {
            root.confirm-show-delete = false;
            root.confirm-project-delete = false;
        }
    }

    forward-focus: window-keys;
    window-keys := HotkeyScope {
        hotkey(text, ctrl, alt, shift) => { root.hotkey(text, ctrl, alt, shift); }
    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: 48px;
            background: root.primary-darker;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;
                Text {
                    text: "FreeShow";
                    color: root.text-color;
                    font-size: 18px * OperatorStyle.font-scale;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                LineEdit {
                    width: 220px;
                    height: 28px;
                    text <=> root.search-query;
                    placeholder-text: "Search";
                    edited(value) => { root.set-search(value); }
                }
                Rectangle { horizontal-stretch: 1; background: root.primary-darker; }
                HeaderButton {
                    label: root.show-labels ? "Settings" : "⚙";
                    accent: root.show-settings ? root.accent : root.primary-lighter;
                    text-color: root.text-color;
                    accent-text: root.show-settings ? root.accent-text : root.text-color;
                    clicked => { root.show-settings = !root.show-settings; root.show-stage-editor = false; }
                }
                HeaderButton {
                    label: root.show-labels ? "Stage edit" : "SE";
                    accent: root.show-stage-editor ? root.accent : root.primary-lighter;
                    text-color: root.text-color;
                    accent-text: root.show-stage-editor ? root.accent-text : root.text-color;
                    clicked => { root.show-stage-editor = !root.show-stage-editor; root.show-settings = false; }
                }
                if root.update-label != "": HeaderButton {
                    label: root.update-label;
                    accent: root.accent;
                    text-color: root.text-color;
                    accent-text: root.accent-text;
                    clicked => { root.get-update(); }
                }
                HeaderButton {
                    label: root.screen-label;
                    accent: root.accent;
                    text-color: root.text-color;
                    accent-text: root.accent-text;
                    clicked => { root.choose-screen(); }
                }
                HeaderButton {
                    label: root.show-labels ? "Output" : "O";
                    accent: root.output-open ? root.accent : root.primary-lighter;
                    text-color: root.text-color;
                    accent-text: root.output-open ? root.accent-text : root.text-color;
                    clicked => { root.open-output(); }
                }
                HeaderButton {
                    label: root.show-labels ? "Stage" : "S";
                    accent: root.stage-open ? root.accent : root.primary-lighter;
                    text-color: root.text-color;
                    accent-text: root.stage-open ? root.accent-text : root.text-color;
                    clicked => { root.open-stage(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 0;
            Rectangle {
                width: 96px;
                background: root.primary-darker;
                VerticalLayout {
                    alignment: start;
                    spacing: 0;
                    for tab in root.tabs: RailButton {
                        label: root.show-labels ? tab.label : tab.short;
                        active: root.active-tab == tab.id;
                        primary: root.primary;
                        accent: root.accent;
                        text-color: root.text-color;
                        accent-text: root.accent-text;
                        clicked => {
                            root.active-tab = tab.id;
                            root.panel-title = tab.label;
                            root.select-tab(tab.id);
                        }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0;
                Rectangle {
                    height: 40px;
                    background: root.primary;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: center;
                        if root.active-tab != "shows" || root.show-name == "": Text {
                            text: root.panel-title;
                            color: root.text-color;
                            font-size: 16px * OperatorStyle.font-scale;
                            vertical-alignment: center;
                        }
                        if root.active-tab != "shows" || root.show-name == "": Rectangle { horizontal-stretch: 1; background: root.primary; }
                        if root.active-tab == "shows" && root.show-name != "": LineEdit {
                            min-width: 80px;
                            preferred-width: 220px;
                            horizontal-stretch: 1;
                            height: 30px;
                            text: root.show-name;
                            placeholder-text: "Show name";
                            accepted(value) => { root.library-action("rename-show", value); }
                        }
                        if root.active-tab == "shows": HeaderButton {
                            label: "New show";
                            accent: root.primary-lighter;
                            text-color: root.text-color;
                            accent-text: root.text-color;
                            clicked => { root.edit-mode = true; root.text-mode = false; root.create-show(); }
                        }
                        if root.active-tab == "shows" && root.show-name != "": HeaderButton {
                            label: "Duplicate";
                            accent: root.primary-lighter;
                            text-color: root.text-color;
                            accent-text: root.text-color;
                            clicked => { root.library-action("duplicate-show", ""); }
                        }
                        if root.active-tab == "shows" && root.show-name != "": HeaderButton {
                            label: root.confirm-show-delete ? "Confirm" : "Delete";
                            accent: root.confirm-show-delete ? #c0392b : root.primary-lighter;
                            text-color: root.text-color;
                            accent-text: root.text-color;
                            clicked => {
                                if (root.confirm-show-delete) {
                                    root.confirm-show-delete = false;
                                    root.library-action("delete-show", "");
                                } else {
                                    root.confirm-show-delete = true;
                                }
                            }
                        }
                        if root.active-tab == "shows" && root.show-name != "": HeaderButton {
                            label: "Edit";
                            accent: root.edit-mode ? root.accent : root.primary-lighter;
                            text-color: root.text-color;
                            accent-text: root.edit-mode ? root.accent-text : root.text-color;
                            clicked => { root.edit-mode = !root.edit-mode; root.text-mode = false; }
                        }
                        if root.editing: HeaderButton {
                            label: root.text-mode ? "Slide text" : "Show text";
                            accent: root.text-mode ? root.accent : root.primary-lighter;
                            text-color: root.text-color;
                            accent-text: root.text-mode ? root.accent-text : root.text-color;
                            clicked => { root.text-mode = !root.text-mode; }
                        }
                        Text {
                            text: "Vol";
                            color: root.text-color;
                            opacity: 0.7;
                            font-size: 12px * OperatorStyle.font-scale;
                            vertical-alignment: center;
                        }
                        Slider {
                            width: 80px;
                            maximum: 100;
                            value <=> root.volume;
                            changed(value) => { root.set-volume(value); }
                        }
                        HeaderButton {
                            label: "Go";
                            accent: root.accent;
                            text-color: root.text-color;
                            accent-text: root.accent-text;
                            clicked => { root.go-slide(root.lyrics); }
                        }
                    }
                }
                if root.active-tab == "scripture": Rectangle {
                    height: 40px;
                    background: root.primary-darker;
                    LineEdit {
                        width: parent.width - 16px;
                        x: 8px;
                        y: 6px;
                        placeholder-text: "Search scripture";
                        edited(value) => { root.search(value); }
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 0;
                    slides-column := VerticalLayout {
                        // Presenting: the slides get the room. Editing: the editor does.
                        min-width: 260px;
                        preferred-width: root.editing || root.slides-columns < 2 ? 300px : 560px;
                        horizontal-stretch: root.editing || root.slides-columns < 2 ? 0 : 1;
                        max-width: root.editing || root.slides-columns < 2 ? 340px : 100000px;
                        spacing: 4px;
                        slides-flick := Flickable {
                            // Fewer, larger cards while the editor shares the row.
                            property <int> columns: root.editing ? min(2, root.slides-columns) : max(1, root.slides-columns);
                            property <length> card-width: (self.width - 8px - (self.columns - 1) * 4px) / self.columns;
                            property <length> card-height: root.slide-cards.length > 0 && root.slide-cards[0].has-thumb ? (self.card-width - 6px) * 9 / 16 + 28px : 36px;
                            vertical-stretch: 1;
                            viewport-width: self.width;
                            viewport-height: ceil(root.slide-cards.length / self.columns) * (self.card-height + 4px) + 8px;
                            // Placed by hand: a layout here would feed card sizes back into the column width.
                            for slide[position] in root.slide-cards: SlideCard {
                                x: 4px + mod(position, slides-flick.columns) * (slides-flick.card-width + 4px);
                                y: 4px + floor(position / slides-flick.columns) * (slides-flick.card-height + 4px);
                                width: slides-flick.card-width;
                                height: slides-flick.card-height;
                                label: slide.label;
                                number: root.active-tab == "scripture" ? 0 : slide.index + 1;
                                thumb: slide.thumb;
                                has-thumb: slide.has-thumb;
                                active: root.selected-slide == slide.index;
                                live: root.live-slide == slide.index;
                                accent: root.accent;
                                text-color: root.text-color;
                                accent-text: root.accent-text;
                                has-color: slide.has-color;
                                full-color: root.full-colors;
                                group-color: slide.group-color;
                                group-text: slide.group-text;
                                clicked => { window-keys.focus(); root.choose-slide(slide.index); }
                            }
                            if root.slide-cards.length == 0 && root.active-tab != "scripture": Text {
                                x: 12px;
                                y: 12px;
                                width: slides-flick.width - 24px;
                                wrap: word-wrap;
                                color: root.text-color;
                                opacity: 0.6;
                                font-size: 13px * OperatorStyle.font-scale;
                                text: "Open a show from the library below or the project on the right. Its slides appear here.";
                            }
                        }
                        if root.editing: HorizontalLayout {
                            padding: 4px;
                            spacing: 4px;
                            BoxButton { label: "Add"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.add-slide(); } }
                            BoxButton { label: "Copy"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.library-action("duplicate-slide", ""); } }
                            BoxButton { label: "Up"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.library-action("slide-up", ""); } }
                            BoxButton { label: "Down"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.library-action("slide-down", ""); } }
                            BoxButton { label: "Delete"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.library-action("delete-slide", ""); } }
                        }
                        if root.editing: HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            padding-bottom: 4px;
                            spacing: 4px;
                            BoxButton { label: "Save as overlay"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.library-action("slide-to-overlay", ""); } }
                            BoxButton { label: "Save as template"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.library-action("slide-to-template", ""); } }
                        }
                    }
                    editor-scroll := ScrollView {
                        horizontal-stretch: 1;
                        min-width: 360px;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, editor-column.min-height);
                    editor-column := VerticalLayout {
                        width: editor-scroll.visible-width;
                        height: editor-scroll.content-height;
                        padding: 12px;
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: !root.editing ? "Live output" : root.live-slide == root.selected-slide ? "Editing the live slide. The output changes as you type." : "Editing this slide. The audience sees it after you press Go.";
                            color: root.text-color;
                            opacity: 0.7;
                            font-size: 12px * OperatorStyle.font-scale;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: root.editing ? 180px : max(120px, min((editor-scroll.width - 40px) * 9 / 16, editor-scroll.height - 110px));
                            background: black;
                            Image {
                                source: root.editing ? root.edit-preview : root.preview;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            BoxButton { label: "Clear all"; accent: #c0392b; text-color: #ffffff; accent-text: #ffffff; clicked => { root.clear-output("all"); } }
                            BoxButton { label: "Slide"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.clear-output("slide"); } }
                            BoxButton { label: "Background"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.clear-output("background"); } }
                            BoxButton { label: "Overlays"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.clear-output("overlays"); } }
                            BoxButton { label: "Audio"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.clear-output("audio"); } }
                        }
                        if root.editing && !root.text-mode: LineEdit {
                            text <=> root.group;
                            placeholder-text: "Group name, e.g. Verse 1 or Chorus";
                            edited(value) => { root.save-group(value); }
                        }
                        if root.editing && !root.text-mode: TextEdit {
                            text <=> root.lyrics;
                            min-height: 140px;
                            vertical-stretch: 1;
                            wrap: word-wrap;
                            edited(text) => { root.lyrics-edited(text); }
                        }
                        show-editor := TextEdit {
                            visible: root.editing && root.text-mode;
                            max-height: root.editing && root.text-mode ? 100000px : 0px;
                            text <=> root.show-text;
                            min-height: root.editing && root.text-mode ? 260px : 0px;
                            vertical-stretch: root.editing && root.text-mode ? 1 : 0;
                            wrap: word-wrap;
                            edited(text) => { root.show-text-edited(text); }
                        }
                        if root.editing && root.text-mode: Text {
                            text: "Blank line = new slide · [Verse 1] on its own line names the group · a repeated [Chorus] reuses one slide";
                            color: root.text-color;
                            opacity: 0.7;
                            font-size: 12px * OperatorStyle.font-scale;
                            wrap: word-wrap;
                        }
                        if root.editing && !root.text-mode: HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: root.item-label;
                                color: root.text-color;
                                font-size: 12px * OperatorStyle.font-scale;
                                vertical-alignment: center;
                            }
                            BoxButton { label: "Prev box"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.prev-item(); } }
                            BoxButton { label: "Next box"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.next-item(); } }
                            BoxButton { label: "Add box"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.add-item(); } }
                            BoxButton { label: "Remove"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.remove-item(); } }
                        }
                        if root.editing && !root.text-mode: InspectorPanel {
                            data: root.inspector-data;
                            text-color: root.text-color;
                            set(key, value) => { root.inspector-set(key, value); }
                        }
                        if root.editing && root.spelling != "": Text {
                            text: root.spelling;
                            color: root.text-color;
                            opacity: 0.75;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    }
                }
            }
            Rectangle {
                width: root.focus-mode ? 0px : root.project-width * 1px;
                background: root.primary;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    alignment: start;
                    if root.project-names.length == 0 && root.project-title == "Project": Text {
                        text: root.project-title;
                        color: root.text-color;
                        font-size: 16px * OperatorStyle.font-scale;
                        font-weight: 700;
                    }
                    if root.project-choices.length > 1: ComboBox {
                        model: root.project-choices;
                        current-index: root.project-choice;
                        selected(value) => { root.library-action("open-project", "\{self.current-index}"); }
                    }
                    if root.project-title != "Project" || root.project-names.length > 0: LineEdit {
                        text: root.project-title;
                        placeholder-text: "Project name";
                        accepted(value) => { root.library-action("rename-project", value); }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        BoxButton { label: "Up"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.move-project(-1); } }
                        BoxButton { label: "Down"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.move-project(1); } }
                        BoxButton { label: "Add"; accent: root.accent; text-color: root.text-color; accent-text: root.accent-text; clicked => { root.add-to-project(); } }
                        BoxButton { label: "New"; accent: root.accent; text-color: root.text-color; accent-text: root.accent-text; clicked => { root.create-project(); } }
                    }
                    if root.project-title != "Project" || root.project-names.length > 0: HorizontalLayout {
                        spacing: 6px;
                        BoxButton { label: "Remove item"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.library-action("remove-project-item", ""); } }
                        BoxButton {
                            label: root.confirm-project-delete ? "Confirm" : "Delete project";
                            accent: root.confirm-project-delete ? #c0392b : root.primary-lighter;
                            text-color: root.text-color;
                            accent-text: root.text-color;
                            clicked => {
                                if (root.confirm-project-delete) {
                                    root.confirm-project-delete = false;
                                    root.library-action("delete-project", "");
                                } else {
                                    root.confirm-project-delete = true;
                                }
                            }
                        }
                    }
                    if root.project-names.length == 0: Text {
                        text: "No project open";
                        color: root.text-color;
                        font-size: 14px * OperatorStyle.font-scale;
                    }
                    if root.project-names.length > 0: VerticalLayout {
                        spacing: 0;
                        alignment: start;
                        for item[index] in root.project-names: ListRow {
                            label: item;
                            active: root.selected-project == index;
                            accent: root.accent;
                            text-color: root.text-color;
                            accent-text: root.accent-text;
                            clicked => {
                                window-keys.focus();
                                root.selected-project = index;
                                root.choose-project(index);
                            }
                        }
                    }
                    if root.now-playing != "": Rectangle {
                        background: root.primary-darker;
                        border-radius: 4px;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            Text {
                                text: (root.now-playing-paused ? "Paused: " : "Playing: ") + root.now-playing;
                                color: root.text-color;
                                font-size: 13px * OperatorStyle.font-scale;
                                overflow: elide;
                            }
                            Rectangle {
                                height: 4px;
                                background: root.primary-lighter;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * clamp(root.now-playing-progress, 0, 1);
                                    background: root.accent;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.now-playing-time;
                                    color: root.text-color;
                                    opacity: 0.7;
                                    font-size: 12px * OperatorStyle.font-scale;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                BoxButton { label: root.now-playing-paused ? "Play" : "Pause"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.audio-control("toggle"); } }
                                BoxButton { label: "Stop"; accent: root.primary-lighter; text-color: root.text-color; accent-text: root.text-color; clicked => { root.audio-control("stop"); } }
                            }
                        }
                    }
                }
            }
        }
        if root.guide-visible: Rectangle {
            background: root.primary-darker;
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                Text {
                    text: root.guide-text;
                    color: root.text-color;
                    font-size: 14px * OperatorStyle.font-scale;
                    wrap: word-wrap;
                    vertical-alignment: top;
                    horizontal-stretch: 1;
                }
                HeaderButton {
                    label: "Dismiss";
                    accent: root.accent;
                    text-color: root.text-color;
                    accent-text: root.accent-text;
                    clicked => { root.dismiss-guide(); }
                }
            }
        }
        if root.show-shortcuts: Rectangle {
            height: 180px;
            background: root.primary;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                TextEdit {
                    text <=> root.shortcut-text;
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    HeaderButton {
                        label: "Save";
                        accent: root.accent;
                        text-color: root.text-color;
                        accent-text: root.accent-text;
                        clicked => { root.save-shortcuts(root.shortcut-text); }
                    }
                    HeaderButton {
                        label: "Close";
                        accent: root.primary-lighter;
                        text-color: root.text-color;
                        accent-text: root.text-color;
                        clicked => { root.show-shortcuts = false; }
                    }
                }
            }
        }
        if root.show-layouts: Rectangle {
            height: 180px;
            background: root.primary;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                TextEdit {
                    text <=> root.layout-text;
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    HeaderButton {
                        label: "Save";
                        accent: root.accent;
                        text-color: root.text-color;
                        accent-text: root.accent-text;
                        clicked => { root.save-layouts(root.layout-text); }
                    }
                    HeaderButton {
                        label: "Close";
                        accent: root.primary-lighter;
                        text-color: root.text-color;
                        accent-text: root.text-color;
                        clicked => { root.show-layouts = false; }
                    }
                }
            }
        }
        if root.show-variables: Rectangle {
            height: 180px;
            background: root.primary;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                TextEdit {
                    text <=> root.variable-text;
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    HeaderButton {
                        label: "Save";
                        accent: root.accent;
                        text-color: root.text-color;
                        accent-text: root.accent-text;
                        clicked => { root.save-variables(root.variable-text); }
                    }
                    HeaderButton {
                        label: "Close";
                        accent: root.primary-lighter;
                        text-color: root.text-color;
                        accent-text: root.text-color;
                        clicked => { root.show-variables = false; }
                    }
                }
            }
        }
        if root.show-timeline: Rectangle {
            height: 180px;
            background: root.primary;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                TextEdit {
                    text <=> root.timeline-text;
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    HeaderButton {
                        label: "Save";
                        accent: root.accent;
                        text-color: root.text-color;
                        accent-text: root.accent-text;
                        clicked => { root.save-timeline(root.timeline-text); }
                    }
                    HeaderButton {
                        label: "Play";
                        accent: root.accent;
                        text-color: root.text-color;
                        accent-text: root.accent-text;
                        clicked => { root.play-timeline(); }
                    }
                    HeaderButton {
                        label: "Close";
                        accent: root.primary-lighter;
                        text-color: root.text-color;
                        accent-text: root.text-color;
                        clicked => { root.show-timeline = false; }
                    }
                }
            }
        }
        if !root.focus-mode: Rectangle {
            // The library keeps a usable share of short windows instead of the rail squeezing it.
            min-height: min(root.drawer-height * 1px, max(120px, root.height * 0.25));
            preferred-height: root.drawer-height * 1px;
            max-height: root.drawer-height * 1px;
            background: root.primary;
            if root.drawer-rows.length == 0 && root.search-query == "": Text {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                wrap: word-wrap;
                color: root.text-color;
                opacity: 0.7;
                font-size: 13px * OperatorStyle.font-scale;
                text: root.active-tab == "shows" ? "No shows yet. Click New show, or drag song files (FreeShow, ProPresenter, OpenLP, OpenLyrics, text, PowerPoint and more) onto this window."
                    : root.active-tab == "media" ? "Drag pictures and videos onto this window to add them to the media library."
                    : root.active-tab == "audio" ? "Drag audio files onto this window to add them."
                    : root.active-tab == "scripture" ? "Drag a Bible file (.fsb or USFM) onto this window to add it."
                    : root.active-tab == "overlays" ? "No overlays yet. Open a show, click Edit, pick a slide and press Save as overlay. Click an overlay here to show or hide it over the output."
                    : root.active-tab == "templates" ? "No templates yet. Open a show, click Edit, pick a styled slide and press Save as template. Click a template here to restyle the open show."
                    : root.active-tab == "calendar" ? "No events yet. Events saved in a FreeShow library (events.json) appear here and run at their set time."
                    : root.active-tab == "player" ? "No player videos yet. YouTube, Vimeo and stream links saved in a FreeShow library appear here."
                    : root.active-tab == "rss" ? "No headlines yet. Headlines appear here once the library has an RSS feed address (rssUrl in its settings)."
                    : "";
            }
            if root.drawer-rows.length == 0 && root.search-query != "": Text {
                x: 16px;
                y: 12px;
                color: root.text-color;
                opacity: 0.7;
                font-size: 13px * OperatorStyle.font-scale;
                text: "Nothing matches “" + root.search-query + "”";
            }
            drawer-flick := Flickable {
                // A wrapping grid, placed by hand so row sizes never feed back into the width.
                property <int> columns: max(1, floor((self.width - 8px) / 224px));
                property <length> cell-width: (self.width - 8px) / self.columns;
                property <length> cell-height: root.drawer-rows.length > 0 && root.drawer-rows[0].show-thumb ? 52px : 38px;
                viewport-width: self.width;
                viewport-height: ceil(root.drawer-rows.length / self.columns) * self.cell-height + 8px;
                for item[index] in root.drawer-rows: ListRow {
                    x: 4px + mod(index, drawer-flick.columns) * drawer-flick.cell-width;
                    y: 4px + floor(index / drawer-flick.columns) * drawer-flick.cell-height;
                    width: drawer-flick.cell-width - 4px;
                    label: item.name;
                    thumb: item.thumb;
                    show-thumb: item.show-thumb;
                    on: item.on;
                    active: root.selected-drawer == index;
                    accent: root.accent;
                    text-color: root.text-color;
                    accent-text: root.accent-text;
                    clicked => { window-keys.focus(); root.choose-drawer(index); }
                }
            }
        }
        Rectangle {
            height: 28px;
            background: root.primary-darker;
            HorizontalLayout {
                padding-left: 12px;
                alignment: center;
                Text {
                    text: root.chrome-status;
                    color: root.text-color;
                    font-size: 12px * OperatorStyle.font-scale;
                    vertical-alignment: center;
                }
                Text {
                    text: root.import-status != "" ? root.import-status : (root.notice != "" ? root.notice : root.data-path);
                    overflow: elide;
                    horizontal-stretch: 1;
                    color: root.text-color;
                    font-size: 12px * OperatorStyle.font-scale;
                    vertical-alignment: center;
                }
                if root.can-restore: HeaderButton {
                    height: 24px;
                    label: "Restore";
                    accent: root.accent;
                    text-color: root.text-color;
                    accent-text: root.accent-text;
                    clicked => { root.library-action("restore-show", ""); }
                }
                if root.import-running: HeaderButton {
                    label: "Cancel import";
                    accent: root.accent;
                    text-color: root.text-color;
                    accent-text: root.accent-text;
                    clicked => { root.cancel-import(); }
                }
            }
        }
    }
        if root.show-settings: SettingsPanel {
            x: 0;
            y: 48px;
            width: parent.width;
            height: parent.height - 48px - 28px;
            background: root.primary;
            data: root.settings-data;
            themes: root.theme-names;
            autosave-choices: root.autosave-choices;
            status: root.settings-status;
            text-color: root.text-color;
            close-fill: root.primary-lighter;
            apply(key, value) => { root.apply-setting(key, value); }
            close => { root.show-settings = false; }
        }
        if root.show-stage-editor && !root.show-settings: StageEditorPanel {
            x: 0;
            y: 48px;
            width: parent.width;
            height: parent.height - 48px - 28px;
            background: root.primary;
            layout-name: root.stage-layout-name;
            rows: root.stage-rows;
            add-kinds: root.stage-add-kinds;
            status: root.stage-status;
            selected <=> root.stage-selected;
            text-color: root.text-color;
            accent: root.accent;
            accent-text: root.accent-text;
            close-fill: root.primary-lighter;
            set(id, key, value) => { root.stage-set(id, key, value); }
            add(kind) => { root.stage-add(kind); }
            remove(id) => { root.stage-remove(id); }
            close => { root.show-stage-editor = false; }
        }
    }
}

export component OutputWindow inherits Window {
    in-out property <image> frame;
    // Clicker and keyboard shortcuts work while this window has focus.
    callback hotkey(string, bool, bool, bool);
    forward-focus: keys;
    keys := HotkeyScope {
        hotkey(text, ctrl, alt, shift) => { root.hotkey(text, ctrl, alt, shift); }
    }
    title: "FreeShow Output";
    background: #000;
    preferred-width: 960px;
    preferred-height: 540px;
    Image {
        source: root.frame;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }
}

export component StageWindow inherits Window {
    in-out property <image> frame;
    // Clicker and keyboard shortcuts work while this window has focus.
    callback hotkey(string, bool, bool, bool);
    forward-focus: keys;
    keys := HotkeyScope {
        hotkey(text, ctrl, alt, shift) => { root.hotkey(text, ctrl, alt, shift); }
    }
    title: "FreeShow Stage";
    background: #000;
    preferred-width: 960px;
    preferred-height: 540px;
    Image {
        source: root.frame;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }
}
